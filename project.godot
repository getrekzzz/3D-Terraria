; Engine configuration file.
; Input actions are registered at runtime from data/config/input.json (see game/Bootstrap/InputSetup.cs)
; so they stay data-driven and rebindable.

config_version=5

[application]

config/name="Strata"
config/description="A native-3D reinterpretation of a 2D sandbox-progression game: volumetric worlds, mining, building, bosses and discovery."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="Strata"

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=false
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
limits/global_shader_variables/buffer_size=524288

[shader_globals]

strata_sky_ambient={
"type": "color",
"value": Color(0.55, 0.62, 0.72, 1)
}
strata_block_light_color={
"type": "color",
"value": Color(1.25, 1.05, 0.85, 1)
}
strata_daylight={
"type": "float",
"value": 1.0
}
strata_night_vision={
"type": "float",
"value": 0.0
}
strata_time={
"type": "float",
"value": 0.0
}
strata_light_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
strata_clouds={
"type": "vec4",
"value": Vector4(0, 0, 0.4, 1600)
}
strata_wind={
"type": "vec4",
"value": Vector4(0.94, 0.35, 0.4, 0)
}
strata_trample={
"type": "vec4",
"value": Vector4(0, -10000, 0, 0.9)
}
strata_cloud_noise={
"type": "sampler2D",
"value": ""
}
