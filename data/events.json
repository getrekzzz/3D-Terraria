      "spawnRateMultiplier": 2.5, "maxNearbyBonus": 4, "skyTint": "#b83030", "preventsSleep": true,
      "startMessage": "The Blood Moon is rising...", "endMessage": "The Blood Moon has set.",
      "covers": ["terraria:blood_moon"]
    },
    {
      "id": "slime_rain", "name": "Slime Rain", "phase": "day", "chance": 0.03,
      "spawnRateMultiplier": 3, "maxNearbyBonus": 6, "killGoal": 60, "killTag": "gel",
      "startMessage": "Slime is falling from the sky!", "endMessage": "Slime has stopped falling from the sky.",
      "covers": ["terraria:slime_rain"]
    }
  ]
