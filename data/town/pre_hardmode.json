    {"id": "stylist", "name": "Stylist", "model": "stylist", "names": ["Bianca", "Cassidy", "Delilah", "Genevieve", "Liza", "Scarlett", "Tiffany", "Vivienne"], "arrival": [{"type": "rescued", "id": "stylist"}], "rescue": {"where": [{"type": "biome", "any": ["spider_nest"]}], "pose": "webbed", "title": "Webbed Stylist", "thanks": "Oh, thank you, {player}! These webs were ruining my hair."}, "life": 250, "defense": 15, "speed": 1.6, "lines": [{"text": "Your hair, {player}. We need to talk about your hair."}, {"text": "Spiders ruin a perfectly good perm."}, {"text": "Sit down, sweetie, and let me work my magic."}, {"text": "Thanks for cutting me out of that web! I owe you a haircut.", "conditions": [{"type": "resident", "id": "stylist"}]}], "mood": [{"biome": "ocean", "score": 1}, {"biome": "tundra", "score": -1}, {"neighbor": "dye_trader", "score": 2}, {"neighbor": "pirate", "score": 1}, {"neighbor": "tavernkeep", "score": -1}, {"neighbor": "goblin_tinkerer", "score": -2}], "covers": ["terraria:stylist"]},
    {"id": "goblin_tinkerer", "name": "Goblin Tinkerer", "model": "goblin_tinkerer", "names": ["Grikkle", "Nixby", "Snogg", "Tizzik", "Vorbo", "Wizzle", "Zilgob", "Krank"], "arrival": [{"type": "rescued", "id": "goblin_tinkerer"}], "rescue": {"requires": [{"type": "flag", "id": "defeated_goblin_army"}], "where": [{"type": "layer", "any": ["cavern"]}], "pose": "bound", "title": "Bound Goblin", "thanks": "Thanks for untying me, {player}! I'll set up shop in town."}, "life": 250, "defense": 15, "speed": 1.6, "shop": [{"item": "rocket_boots"}, {"item": "tinkerers_workshop"}, {"item": "grappling_hook"}, {"item": "spiky_ball"}], "service": {"type": "reforge", "costFactor": 0.33}, "lines": [{"text": "Thanks for sorting out my kin, {player}. They were never the tinkering type."}, {"text": "Give me that and a few coins, and I'll make it better. Probably."}, {"text": "Rocket boots! Every adventurer needs rocket boots."}, {"text": "{resident:mechanic} understands gears. We get along.", "conditions": [{"type": "resident", "id": "mechanic"}]}, {"text": "Thanks for untying me. I'd have been stuck down there forever!", "conditions": [{"type": "resident", "id": "goblin_tinkerer"}]}], "mood": [{"layer": "underground", "score": 1}, {"biome": "jungle", "score": -1}, {"neighbor": "mechanic", "score": 2}, {"neighbor": "dye_trader", "score": 1}, {"neighbor": "clothier", "score": -1}, {"neighbor": "stylist", "score": -2}], "covers": ["terraria:goblin_tinkerer"]},
