    {"id": "clothier", "name": "Clothier", "model": "clothier", "names": ["Alistair", "Bartholomew", "Cedric", "Duncan", "Edmund", "Frederick", "Gilbert", "Harold"], "arrival": [{"type": "flag", "id": "defeated_skeletron"}], "life": 250, "defense": 15, "speed": 1.4, "shop": [{"item": "top_hat"}, {"item": "tuxedo_shirt"}, {"item": "tuxedo_pants"}, {"item": "silk", "price": 600}, {"item": "loom", "price": 1500}, {"item": "bone", "price": 150, "conditions": [{"type": "time", "is": "night"}]}], "lines": [{"text": "Free at last, and I have you to thank, {player}. Let me mend something for you."}, {"text": "Decades in rags at that door. Never again. Silk, only silk."}, {"text": "I still dream of the hands. I wake and my own are shaking."}, {"text": "{resident:guide} says I talk to the walls. Old habit.", "conditions": [{"type": "resident", "id": "guide"}]}], "mood": [{"layer": "underground", "score": 1}, {"biome": "hallow", "score": -1}, {"neighbor": "truffle", "score": 2}, {"neighbor": "tax_collector", "score": 1}, {"neighbor": "nurse", "score": -1}, {"neighbor": "mechanic", "score": -2}], "covers": ["terraria:clothier"]},
