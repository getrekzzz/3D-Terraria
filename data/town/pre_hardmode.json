    {"id": "golfer", "name": "Golfer", "model": "golfer", "names": ["Arnie", "Bobby", "Chip", "Duffy", "Mulligan", "Par", "Tiger", "Woody"], "arrival": [{"type": "rescued", "id": "golfer"}], "rescue": {"where": [{"type": "biome", "any": ["underground_desert"]}], "pose": "unconscious", "title": "Lost Girl", "thanks": "Thanks, {player}! I was looking for my ball. See you in town!"}, "life": 250, "defense": 15, "speed": 1.6, "lines": [{"text": "Fore! Sorry, {player}, habit."}, {"text": "A good swing is all in the hips."}, {"text": "The underground desert makes a terrible bunker."}, {"text": "I was lost in the desert looking for my ball. Thanks for finding me!", "conditions": [{"type": "resident", "id": "golfer"}]}], "mood": [{"biome": "forest", "score": 1}, {"layer": "underground", "score": -1}, {"neighbor": "angler", "score": 2}, {"neighbor": "painter", "score": 1}, {"neighbor": "zoologist", "score": 1}, {"neighbor": "pirate", "score": -1}, {"neighbor": "merchant", "score": -2}], "covers": ["terraria:golfer"]},
