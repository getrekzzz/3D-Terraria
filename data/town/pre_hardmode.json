  // (data/config/housing.json); rescued NPCs arrive once freed (flag rescued_<id>). One NPC per line.
  "townNpcs": [
    {"id": "guide", "name": "Guide", "model": "guide", "starter": true, "names": ["Aldous", "Brannoc", "Corin", "Dace", "Evander", "Faolan", "Gideon", "Hollis"], "life": 250, "defense": 15, "speed": 1.5, "service": {"type": "craftHelp"}, "lines": [{"text": "Welcome, {player}. Chop some trees, build a Work Bench, and the world opens up from there."}, {"text": "A home needs walls you built, a door, a light, a table and a chair. Open the Housing menu in your inventory to check a room or move someone in."}, {"text": "Show me an item and I will tell you what it can become."}, {"text": "Gel from the hopping slimes burns well in a torch.", "conditions": [{"type": "time", "is": "day"}]}, {"text": "The night brings out the dead. Stay behind a closed door.", "conditions": [{"type": "time", "is": "night"}]}, {"text": "An old man keeps the door of the dungeon by the cold coast. Talk to him before you go digging.", "conditions": [{"type": "flag", "id": "defeated_skeletron", "set": false}]}, {"text": "Lava and water do not mix. Well, they do, but you get stone out of it.", "conditions": [{"type": "hasItem", "item": "lava_bucket"}]}, {"text": "{resident:merchant} keeps a good stock of torches, if you have the coin.", "conditions": [{"type": "resident", "id": "merchant"}]}], "mood": [{"biome": "forest", "score": 1}, {"biome": "ocean", "score": -1}, {"neighbor": "clothier", "score": 1}, {"neighbor": "zoologist", "score": 1}, {"neighbor": "steampunker", "score": -1}, {"neighbor": "painter", "score": -2}], "covers": ["terraria:guide"]},
    {"id": "merchant", "name": "Merchant", "model": "merchant", "names": ["Abner", "Barnaby", "Cletus", "Darby", "Emmett", "Fenwick", "Gustav", "Horace"], "arrival": [{"type": "coins", "min": 5000}], "life": 250, "defense": 15, "speed": 1.5, "shop": [{"item": "torch", "price": 50}, {"item": "bottle", "price": 20}, {"item": "wooden_arrow", "price": 5}, {"item": "lesser_healing_potion", "price": 300}, {"item": "lesser_mana_potion", "price": 100}, {"item": "copper_pickaxe", "price": 1000}, {"item": "copper_axe", "price": 800}, {"item": "empty_bucket", "price": 600}, {"item": "rope", "price": 10}, {"item": "shuriken", "price": 15}, {"item": "bug_net", "price": 2500}, {"item": "mining_helmet", "price": 40000}, {"item": "mining_shirt"}, {"item": "mining_pants"}, {"item": "piggy_bank"}, {"item": "iron_anvil", "price": 5000}, {"item": "glowstick", "conditions": [{"type": "time", "is": "night"}]}], "lines": [{"text": "Everything has a price, {player}. Today it is a fair one."}, {"text": "Torches! Bottles! Buckets! The finest goods this side of the caverns."}, {"text": "I buy anything, at a fifth of what it is worth. Business is business."}, {"text": "{resident:nurse} charges more than I do. Remember that.", "conditions": [{"type": "resident", "id": "nurse"}]}, {"text": "Blood in the sky tonight. Bad for trade.", "conditions": [{"type": "event", "id": "blood_moon"}]}], "mood": [{"biome": "forest", "score": 1}, {"biome": "desert", "score": -1}, {"neighbor": "golfer", "score": 2}, {"neighbor": "nurse", "score": 2}, {"neighbor": "tax_collector", "score": -1}, {"neighbor": "angler", "score": -2}], "covers": ["terraria:merchant"]},
    {"id": "nurse", "name": "Nurse", "model": "nurse", "names": ["Ada", "Brigid", "Cora", "Delphine", "Edith", "Faye", "Greta", "Hazel"], "arrival": [{"type": "maxLife", "min": 120}, {"type": "resident", "id": "merchant"}], "life": 250, "defense": 15, "speed": 1.6, "service": {"type": "heal", "costPerLife": 1, "perDebuff": 100, "clearsDebuffs": true, "expertMultiplier": 2, "tiers": [{"flag": "defeated_golem", "multiplier": 200}, {"flag": "defeated_plantera", "multiplier": 150}, {"flag": "defeated_mechanical_boss", "multiplier": 100}, {"flag": "hardmode", "multiplier": 60}, {"flag": "defeated_skeletron", "multiplier": 25}, {"flag": "defeated_queen_bee", "multiplier": 25}, {"flag": "defeated_evil_boss", "multiplier": 10}, {"flag": "defeated_eye_of_cthulhu", "multiplier": 3}]}, "lines": [{"text": "Hold still, {player}. This will only sting a little."}, {"text": "Another bruise? I charge by the wound."}, {"text": "You look pale. When did you last eat something that was not a mushroom?"}, {"text": "{resident:merchant} keeps asking for a discount. He will not get one.", "conditions": [{"type": "resident", "id": "merchant"}]}], "mood": [{"biome": "hallow", "score": 1}, {"biome": "tundra", "score": -1}, {"neighbor": "arms_dealer", "score": 2}, {"neighbor": "wizard", "score": 1}, {"neighbor": "dryad", "score": -1}, {"neighbor": "party_girl", "score": -1}, {"neighbor": "zoologist", "score": -2}], "covers": ["terraria:nurse"]},
    {"id": "demolitionist", "name": "Demolitionist", "model": "demolitionist", "names": ["Bartok", "Dolgrim", "Grunwald", "Kazrik", "Thorin", "Urist", "Varek", "Zagar"], "arrival": [{"type": "any", "of": [{"type": "hasItem", "item": "bomb"}, {"type": "hasItem", "item": "dynamite"}, {"type": "hasItem", "item": "grenade"}]}, {"type": "resident", "id": "merchant"}], "life": 250, "defense": 15, "speed": 1.6, "shop": [{"item": "grenade"}, {"item": "bomb"}, {"item": "dynamite"}], "lines": [{"text": "Stand back, {player}. No, further. Further."}, {"text": "A little dynamite solves most problems. A lot of dynamite solves the rest."}, {"text": "Mining by hand? How quaint."}], "mood": [{"layer": "underground", "score": 1}, {"biome": "ocean", "score": -1}, {"neighbor": "mechanic", "score": 2}, {"neighbor": "tavernkeep", "score": 1}, {"neighbor": "arms_dealer", "score": -1}, {"neighbor": "goblin_tinkerer", "score": -1}], "covers": ["terraria:demolitionist"]},
    {"id": "dye_trader", "name": "Dye Trader", "model": "dye_trader", "names": ["Abdul", "Farid", "Hakim", "Jamil", "Kasim", "Rashid", "Samir", "Tariq"], "arrival": [{"type": "hasItem", "category": "dye"}, {"type": "residents", "min": 4}], "life": 250, "defense": 15, "speed": 1.6, "shop": [{"item": "dye_vat"}, {"item": "silver_dye"}, {"item": "brown_dye"}, {"item": "black_dye"}, {"item": "red_dye"}, {"item": "orange_dye"}, {"item": "yellow_dye"}, {"item": "green_dye"}, {"item": "blue_dye"}, {"item": "purple_dye"}, {"item": "pink_dye"}], "lines": [{"text": "Colours, {player}! The world is far too grey."}, {"text": "Bring me strange plants and I will make you wonders."}, {"text": "Such a lovely shade of... dirt."}], "mood": [{"biome": "desert", "score": 1}, {"biome": "forest", "score": -1}, {"neighbor": "arms_dealer", "score": 1}, {"neighbor": "painter", "score": 1}, {"neighbor": "steampunker", "score": -1}, {"neighbor": "pirate", "score": -2}], "covers": ["terraria:dye_trader"]},
    {"id": "angler", "name": "Angler", "model": "angler", "names": ["Adam", "Bart", "Billy", "Cody", "Dennis", "Kyle", "Spencer", "Timmy"], "arrival": [{"type": "rescued", "id": "angler"}], "rescue": {"where": [{"type": "biome", "any": ["ocean"]}, {"type": "layer", "any": ["surface"]}], "pose": "sleeping", "title": "Sleeping Angler", "thanks": "You woke me up! Fine, I'll move into your town. You work for me now."}, "life": 250, "defense": 15, "speed": 1.6, "shop": [{"item": "pile_of_seashells", "price": 2500, "conditions": [{"type": "anglerQuests", "min": 1}]}, {"item": "treasure_map", "price": 5000, "conditions": [{"type": "anglerQuests", "min": 1}]}, {"item": "seaweed_planter", "price": 7500, "conditions": [{"type": "anglerQuests", "min": 3}]}, {"item": "lifebuoy", "price": 10000, "conditions": [{"type": "anglerQuests", "min": 3}]}, {"item": "ships_wheel", "price": 15000, "conditions": [{"type": "anglerQuests", "min": 5}]}, {"item": "wall_anchor", "price": 15000, "conditions": [{"type": "anglerQuests", "min": 5}]}, {"item": "bass_plaque", "price": 20000, "conditions": [{"type": "anglerQuests", "min": 10}]}, {"item": "trout_plaque", "price": 20000, "conditions": [{"type": "anglerQuests", "min": 15}]}, {"item": "tuna_plaque", "price": 30000, "conditions": [{"type": "anglerQuests", "min": 20}]}], "service": {"type": "anglerQuest", "fish": ["bunnyfish", "slimefish", "dynamite_fish", "zombie_fish", "fallen_starfish", "catfish", "mudfish", "pengfish", "mutant_flinxfin", "scarab_fish", "scorpio_fish", "clownfish", "angelfish", "cloudfish", "harpyfish", "batfish", "spiderfish", "jewelfish", "bonefish", "amanitia_fungifin", "demonic_hellfish", "bumblebee_tuna"], "rewards": [{"item": "crate_potion", "count": 2, "everyQuests": 5}, {"item": "golden_fishing_rod", "everyQuests": 30, "minQuests": 30}, {"item": "golden_fishing_rod", "chance": 0.04, "minQuests": 15}, {"item": "hotline_fishing_hook", "chance": 0.04, "minQuests": 10}, {"item": "angler_earring", "chance": 0.07, "minQuests": 5}, {"item": "tackle_box", "chance": 0.07, "minQuests": 5}, {"item": "fiberglass_fishing_pole", "chance": 0.08}, {"item": "reinforced_fishing_pole", "chance": 0.12}, {"item": "fishing_potion", "count": 3, "chance": 0.15}, {"item": "crate_potion", "count": 2, "chance": 0.12}, {"item": "master_bait", "count": 3, "chance": 0.15}, {"item": "journeyman_bait", "count": 5, "chance": 0.3}, {"item": "apprentice_bait", "count": 5}], "coins": [2000, 10000]}, "lines": [{"text": "You there, {player}! Go catch me a fish. Now!"}, {"text": "I'm not a kid, I'm a professional angler."}, {"text": "If you don't bring me that fish, I'm telling everyone you're a big fat dummy."}, {"text": "You woke me up, so now you work for me. Got any fish?", "conditions": [{"type": "resident", "id": "angler"}]}], "mood": [{"biome": "ocean", "score": 1}, {"biome": "desert", "score": -1}, {"neighbor": "demolitionist", "score": 1}, {"neighbor": "party_girl", "score": 1}, {"neighbor": "tax_collector", "score": 1}, {"neighbor": "tavernkeep", "score": -2}], "covers": ["terraria:angler"]},
    {"id": "zoologist", "name": "Zoologist", "model": "zoologist", "names": ["Amber", "Cleo", "Flora", "Juniper", "Lynx", "Maple", "Poppy", "Willow"], "arrival": [{"type": "bestiary", "min": 10}], "life": 250, "defense": 15, "speed": 1.6, "lines": [{"text": "Every creature has a story, {player}. Most of them end with teeth."}, {"text": "Have you seen the bunnies? They're SO cute."}, {"text": "I've catalogued every slime in the forest. Twice."}], "mood": [{"biome": "forest", "score": 1}, {"biome": "desert", "score": -1}, {"neighbor": "witch_doctor", "score": 2}, {"neighbor": "golfer", "score": 1}, {"neighbor": "angler", "score": -1}, {"neighbor": "arms_dealer", "score": -2}], "covers": ["terraria:zoologist"]},
    {"id": "dryad", "name": "Dryad", "model": "dryad", "names": ["Aspen", "Briar", "Cedra", "Elowen", "Fern", "Iris", "Linnea", "Rowan"], "arrival": [{"type": "any", "of": [{"type": "flag", "id": "defeated_king_slime"}, {"type": "flag", "id": "defeated_eye_of_cthulhu"}, {"type": "flag", "id": "defeated_evil_boss"}, {"type": "flag", "id": "defeated_queen_bee"}, {"type": "flag", "id": "defeated_skeletron"}, {"type": "flag", "id": "defeated_deerclops"}, {"type": "flag", "id": "defeated_wall_of_flesh"}]}], "life": 250, "defense": 15, "speed": 1.6, "shop": [{"item": "purification_powder"}, {"item": "vile_powder", "price": 100, "conditions": [{"type": "evil", "is": "corruption"}]}, {"item": "vicious_powder", "price": 100, "conditions": [{"type": "evil", "is": "crimson"}]}, {"item": "grass_seeds"}, {"item": "sunflower"}, {"item": "acorn", "price": 50}, {"item": "herb_bag"}, {"item": "jungle_grass_seeds", "conditions": [{"type": "biome", "any": ["jungle", "underground_jungle"]}]}, {"item": "mushroom_grass_seeds", "conditions": [{"type": "biome", "any": ["mushroom"]}]}, {"item": "corrupt_seeds", "conditions": [{"type": "flag", "id": "hardmode"}, {"type": "evil", "is": "corruption"}]}, {"item": "crimson_seeds", "conditions": [{"type": "flag", "id": "hardmode"}, {"type": "evil", "is": "crimson"}]}, {"item": "hallowed_seeds", "conditions": [{"type": "flag", "id": "hardmode"}]}], "services": [{"type": "worldStatus"}], "lines": [{"text": "The forest remembers every tree you fell, {player}. Plant one back now and then."}, {"text": "I felt it when the great one fell. The land breathes easier."}, {"text": "Something rots beneath the surface. Keep it from spreading."}, {"text": "The jungle is loud tonight.", "conditions": [{"type": "time", "is": "night"}]}], "mood": [{"biome": "jungle", "score": 1}, {"biome": "desert", "score": -1}, {"neighbor": "witch_doctor", "score": 2}, {"neighbor": "truffle", "score": 1}, {"neighbor": "angler", "score": -1}, {"neighbor": "golfer", "score": -2}],