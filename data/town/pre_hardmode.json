    {"id": "tavernkeep", "name": "Tavernkeep", "model": "tavernkeep", "names": ["Barney", "Bjorn", "Duncan", "Fergus", "Gideon", "Hamish", "Ivor", "Magnus"], "arrival": [{"type": "rescued", "id": "tavernkeep"}], "rescue": {"requires": [{"type": "flag", "id": "defeated_evil_boss"}], "where": [{"type": "layer", "any": ["surface"]}], "pose": "unconscious", "title": "Unconscious Man", "thanks": "Where... where am I? Thanks, {player}. I'll find a room in town."}, "life": 250, "defense": 15, "speed": 1.6, "shop": [{"item": "eternia_crystal", "price": 10000}, {"item": "eternia_crystal_stand"}, {"item": "ale", "price": 1, "currency": "defender_medal"}], "lines": [{"text": "Pull up a stool, {player}. Mind the sticky bit."}, {"text": "Pint's on the house. The house is very small."}, {"text": "Folk from another world keep turning up. Odd lot."}, {"text": "Where am I? Last I remember, I was serving ale in Etheria... thanks for waking me.", "conditions": [{"type": "resident", "id": "tavernkeep"}]}], "mood": [{"biome": "hallow", "score": 1}, {"biome": "tundra", "score": -1}, {"neighbor": "demolitionist", "score": 2}, {"neighbor": "goblin_tinkerer", "score": 1}, {"neighbor": "guide", "score": -1}, {"neighbor": "dye_trader", "score": -2}], "covers": ["terraria:tavernkeep"]},
    {"id": "old_man", "name": "Old Man", "model": "old_man", "landmark": "dungeon_gate", "names": ["Aurelius", "Barnabas", "Cornelius", "Ezekiel", "Mordecai", "Obadiah", "Silas", "Thaddeus"], "life": 250, "defense": 15, "speed": 0.9, "leavesWhen": [{"type": "flag", "id": "defeated_skeletron"}], "service": {"type": "summonBoss", "enemy": "skeletron", "label": "Break the curse", "height": 7, "conditions": [{"type": "time", "is": "night"}], "failMessage": "Not while the sun watches. Come back after dark."}, "lines": [{"text": "You cannot go in, {player}. The dungeon keeps what it takes, and it keeps me at its door."}, {"text": "Something wears my name down there. Its hands never rest."}, {"text": "Break the curse, and I will be free. Try it by day and it will break you instead."}, {"text": "The walls will not yield to your pick while it stands.", "conditions": [{"type": "time", "is": "day"}]}, {"text": "Night again. I feel it stirring behind me.", "conditions": [{"type": "time", "is": "night"}]}], "covers": ["terraria:old_man"]}
