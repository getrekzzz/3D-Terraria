{
  // The Guide's progression steps (P5-27), in the reference game's order. doneWhen/showWhen are achievement
  // triggers (Content/Specs/AchievementSpecs.cs); a step is offered once its 'after' steps are done.
  "guideSteps": [
    { "id": "work_bench", "name": "Craft a Work Bench", "order": 10, "stage": "preHardmode", "text": "You can use the wood you chop to craft a Work Bench. It lets you make more complicated things, like doors, chairs and tables, and it is where every house begins.", "doneWhen": [{ "type": "craftItem", "item": "work_bench" }], "relatedItems": ["work_bench", "wood"] },
    { "id": "shelter", "name": "Build a house", "order": 20, "stage": "preHardmode", "after": ["work_bench"], "text": "Night will come soon, and the monsters with it. Build a house: walls, a floor and a roof, a door, a light, a table and a chair. Someone like me could move in, and others will follow.", "doneWhen": [{ "type": "housed", "min": 1 }], "relatedItems": ["wooden_door", "torch"] },
    { "id": "furnace", "name": "Build a Furnace", "order": 30, "stage": "preHardmode", "after": ["work_bench"], "text": "A Furnace made from stone, wood and torches lets you smelt the ore you dig up into bars.", "doneWhen": [{ "type": "obtainItem", "item": "furnace" }], "relatedItems": ["furnace"] },
    { "id": "smelt_bars", "name": "Smelt metal bars", "order": 40, "stage": "preHardmode", "after": ["furnace"], "text": "Dig underground for copper, tin, iron and lead ore, then smelt it into bars at your Furnace. Bars make far better gear than wood.", "doneWhen": [{ "type": "flag", "id": "smelted_metal" }], "relatedItems": ["copper_ore"] },
    { "id": "anvil", "name": "Make an anvil", "order": 50, "stage": "preHardmode", "after": ["smelt_bars"], "text": "An Iron or Lead Anvil is needed for metal tools, weapons and armor. Make one from bars at your Work Bench.", "doneWhen": [{ "type": "obtainItem", "items": ["iron_anvil", "lead_anvil"] }], "relatedItems": ["iron_anvil", "lead_anvil"] },
    { "id": "better_pickaxe", "name": "Upgrade your pickaxe", "order": 60, "stage": "preHardmode", "after": ["anvil"], "text": "Your copper pickaxe will only take you so far. Forge a pickaxe of iron, lead or better to dig through tougher ores.", "doneWhen": [{ "type": "obtainItem", "items": ["iron_pickaxe", "lead_pickaxe", "silver_pickaxe", "tungsten_pickaxe", "gold_pickaxe", "platinum_pickaxe"] }], "relatedItems": ["iron_pickaxe"] },
    { "id": "life_crystal", "name": "Find a Life Crystal", "order": 70, "stage": "preHardmode", "after": ["work_bench"], "text": "Deep underground you may find glowing red Life Crystals. Smash one and use it to raise your maximum life for good.", "doneWhen": [{ "type": "flag", "id": "found_life_crystal" }], "relatedItems": ["life_crystal"] },
    { "id": "explore_caverns", "name": "Explore the caverns", "order": 80, "stage": "preHardmode", "after": ["better_pickaxe"], "text": "The deeper caverns hold gold, gems, chests and danger. Bring torches, and a rope or a grappling hook to get back up.", "doneWhen": [{ "type": "reachLayer", "layer": "cavern" }], "relatedItems": ["torch", "grappling_hook"] },
    { "id": "mana_crystal", "name": "Gather mana", "order": 90, "stage": "preHardmode", "after": ["anvil"], "text": "Fallen Stars rain down at night. Five of them make a Mana Crystal, which expands the mana you need for magic.", "doneWhen": [{ "type": "obtainItem", "item": "mana_crystal" }], "relatedItems": ["mana_crystal", "fallen_star"] },
    { "id": "king_slime", "name": "Defeat King Slime", "order": 100, "stage": "preHardmode", "after": ["better_pickaxe"], "text": "Slime is falling out of the sky... When the slimes gather, their king may come. A Slime Crown would summon him, if you are brave.", "doneWhen": [{ "type": "flag", "id": "defeated_king_slime" }], "relatedItems": ["slime_crown"], "relatedEnemies": ["king_slime"] },
    { "id": "eye_of_cthulhu", "name": "Defeat the Eye of Cthulhu", "order": 110, "stage": "preHardmode", "after": ["better_pickaxe", "life_crystal"], "text": "You feel an evil presence watching you... Craft a Suspicious Looking Eye from lenses at a Demon Altar and use it at night to face the Eye of Cthulhu.", "doneWhen": [{ "type": "flag", "id": "defeated_eye_of_cthulhu" }], "relatedItems": ["suspicious_looking_eye", "lens"], "relatedEnemies": ["eye_of_cthulhu"] },
    { "id": "evil_boss", "name": "Defeat the evil biome's boss", "order": 120, "stage": "preHardmode", "after": ["eye_of_cthulhu"], "text": "Smash the Shadow Orbs of the Corruption or the Crimson Hearts of the Crimson, or craft Worm Food or a Bloody Spine, and its guardian will come for you.", "doneWhen": [{ "type": "flag", "id": "defeated_evil_boss" }], "relatedItems": ["worm_food", "bloody_spine"], "relatedEnemies": ["eater_of_worlds", "brain_of_cthulhu"] },
    { "id": "meteorite", "name": "Mine a meteorite", "order": 130, "stage": "preHardmode", "after": ["evil_boss"], "text": "Once the orbs have been broken, meteorites may crash into the world at night. Their ore makes powerful space gear, but it is hot to the touch.", "doneWhen": [{ "type": "obtainItem", "item": "meteorite_bar" }], "relatedItems": ["meteorite_bar"] },
    { "id": "goblin_army", "name": "Repel the goblin army", "order": 140, "stage": "preHardmode", "after": ["evil_boss"], "text": "A goblin army is gathering! Defeat them and a Goblin Tinkerer may be found tied up deep underground.", "doneWhen": [{ "type": "flag", "id": "defeated_goblin_army" }] },
    { "id": "queen_bee", "name": "Defeat the Queen Bee", "order": 150, "stage": "preHardmode", "after": ["evil_boss"], "text": "Deep in the jungle are hives filled with honey and larvae. Break a larva, or use an Abeemination, to bring out the Queen Bee.", "doneWhen": [{ "type": "flag", "id": "defeated_queen_bee" }], "relatedItems": ["abeemination"], "relatedEnemies": ["queen_bee"] },
    { "id": "skeletron", "name": "Defeat Skeletron", "order": 160, "stage": "preHardmode", "after": ["evil_boss"], "text": "An old man stands at the entrance of the dungeon. Talk to him at night and you may free him from his curse... if you can defeat Skeletron.", "doneWhen": [{ "type": "flag", "id": "defeated_skeletron" }], "relatedItems": ["clothier_voodoo_doll"], "relatedEnemies": ["skeletron"] },
    { "id": "dungeon", "name": "Explore the Dungeon", "order": 170, "stage": "preHardmode", "after": ["skeletron"], "text": "With Skeletron gone, the Dungeon is open. Its undead denizens carry golden keys that open its locked chests.", "doneWhen": [{ "type": "obtainItem", "item": "golden_key" }], "relatedItems": ["golden_key"] },
    { "id": "underworld", "name": "Reach the Underworld", "order": 180, "stage": "preHardmode", "after": ["evil_boss"], "text": "Far below the caverns burns the Underworld. Bring obsidian skin potions if you can, and do not step in the lava.", "doneWhen": [{ "type": "reachLayer", "layer": "underworld" }] },
    { "id": "hellstone", "name": "Forge Hellstone bars", "order": 190, "stage": "preHardmode", "after": ["underworld"], "text": "Hellstone in the Underworld can be smelted at a Hellforge into the hottest of bars: they make the Molten Pickaxe and Molten armor.", "doneWhen": [{ "type": "flag", "id": "forged_hellstone" }], "relatedItems": ["hellstone_bar", "hellstone_pickaxe"] },
    { "id": "wall_of_flesh", "name": "Defeat the Wall of Flesh", "order": 200, "stage": "preHardmode", "after": ["hellstone"], "text": "There is a powerful creature who rules the Underworld. Drop a Guide Voodoo Doll into the lava there to summon the Wall of Flesh. Be ready, for the world will change forever.", "doneWhen": [{ "type": "flag", "id": "defeated_wall_of_flesh" }], "relatedItems": ["guide_voodoo_doll"], "relatedEnemies": ["wall_of_flesh"] },
    { "id": "smash_altar", "name": "Smash a demon altar", "order": 210, "stage": "hardmode", "after": ["wall_of_flesh"], "text": "The ancient spirits of light and dark have been released. Smash the demon altars with your Pwnhammer and new ores will bless the world.", "doneWhen": [{ "type": "flag", "id": "smashed_altar_1" }], "relatedItems": ["pwnhammer"] },
    { "id": "hardmode_ore", "name": "Mine hardmode ore", "order": 220, "stage": "hardmode", "after": ["smash_altar"], "text": "Cobalt and palladium, mythril and orichalcum, adamantite and titanium now lie in the caverns. Each tier needs a stronger pickaxe.", "doneWhen": [{ "type": "mineBlock", "tag": "hardmode" }] },
    { "id": "mechanical_boss", "name": "Defeat a mechanical boss", "order": 230, "stage": "hardmode", "after": ["hardmode_ore"], "text": "Something mechanical stirs at night. A Mechanical Eye, Worm or Skull summons the Twins, the Destroyer or Skeletron Prime.", "doneWhen": [{ "type": "flag", "id": "defeated_mechanical_boss" }], "relatedItems": ["mechanical_eye", "mechanical_worm", "mechanical_skull"], "relatedEnemies": ["retinazer", "the_destroyer", "skeletron_prime"] },
    { "id": "all_mechs", "name": "Defeat all three mechanical bosses", "order": 240, "stage": "hardmode", "after": ["mechanical_boss"], "text": "Their hallowed bars forge the finest gear. Defeat all three mechanical bosses and the jungle will change.", "doneWhen": [{ "type": "flag", "id": "defeated_all_mechs" }], "relatedItems": ["hallowed_bar"] },
    { "id": "plantera", "name": "Defeat Plantera", "order": 250, "stage": "hardmode", "after": ["all_mechs"], "text": "Pink bulbs have sprouted in the underground jungle. Break one to wake Plantera, the overgrown monstrosity of the jungle's depths.", "doneWhen": [{ "type": "flag", "id": "defeated_plantera" }], "relatedEnemies": ["plantera"] },
    { "id": "golem", "name": "Defeat Golem", "order": 260, "stage": "hardmode", "after": ["plantera"], "text": "Plantera carried the key to the Jungle Temple. Inside, a Lihzahrd Power Cell placed on the altar wakes Golem.", "doneWhen": [{ "type": "flag", "id": "defeated_golem" }], "relatedItems": ["temple_key", "lihzahrd_power_cell"], "relatedEnemies": ["golem"] },
    { "id": "duke_fishron", "name": "Defeat Duke Fishron", "order": 265, "stage": "hardmode", "after": ["all_mechs"], "text": "Fish in the ocean with a Truffle Worm as bait and something terrible will bite: Duke Fishron, mutant terror of the sea.", "doneWhen": [{ "type": "flag", "id": "defeated_duke_fishron" }], "relatedItems": ["truffle_worm"], "relatedEnemies": ["duke_fishron"] },
    { "id": "lunatic_cultist", "name": "Defeat the Lunatic Cultist", "order": 270, "stage": "hardmode", "after": ["golem"], "text": "Cultists have gathered at the dungeon's entrance. Strike them down and their leader, the Lunatic Cultist, will rise.", "doneWhen": [{ "type": "flag", "id": "defeated_lunatic_cultist" }], "relatedEnemies": ["lunatic_cultist"] },
    { "id": "celestial_pillars", "name": "Destroy the Celestial Pillars", "order": 280, "stage": "hardmode", "after": ["lunatic_cultist"], "text": "Four Celestial Pillars have appeared across the world, each shielded by its legion. Slay enough of them to break the shield and destroy the pillar.", "doneWhen": [{ "type": "flag", "id": "defeated_pillars" }], "relatedEnemies": ["solar_pillar", "vortex_pillar", "nebula_pillar", "stardust_pillar"] },
    { "id": "moon_lord", "name": "Defeat the Moon Lord", "order": 290, "stage": "hardmode", "after": ["celestial_pillars"], "text": "Impending doom approaches... The Moon Lord descends. Destroy his hands and head, then his heart.", "doneWhen": [{ "type": "flag", "id": "defeated_moon_lord" }], "relatedItems": ["celestial_sigil"], "relatedEnemies": ["moon_lord"] },
    { "id": "zenith", "name": "Forge the Zenith", "order": 300, "stage": "postMoonLord", "after": ["moon_lord"], "text": "The greatest blades of the world, joined at an Ancient Manipulator, make the Zenith: the bane of everything.", "doneWhen": [{ "type": "obtainItem", "item": "zenith" }], "relatedItems": ["zenith"] }
  ]
}
