{
  // Tips for the Guide's book (P5-27). {key:action} shows the key bound to an input action (data/config/input.json);
  // controls tips name their action for the book's controls list.
  "guideTips": [
    { "id": "controls_move", "name": "Moving", "topic": "controls", "action": "move_forward", "text": "Walk with {key:move_forward} {key:move_left} {key:move_back} {key:move_right}; hold {key:sprint} to run." },
    { "id": "controls_jump", "name": "Jumping", "topic": "controls", "action": "jump", "text": "Press {key:jump} to jump. Some boots and wings let you jump again in the air." },
    { "id": "controls_use", "name": "Using items", "topic": "controls", "action": "use_primary", "text": "Press {key:use_primary} to swing, shoot, dig or place what you hold." },
    { "id": "controls_use_secondary", "name": "Alternate use", "topic": "controls", "action": "use_secondary", "text": "{key:use_secondary} uses an item's alternate action, such as opening a chest or reading a sign." },
    { "id": "controls_interact", "name": "Interacting", "topic": "controls", "action": "interact", "text": "Press {key:interact} to talk to townsfolk, open doors and chests, and sit on chairs." },
    { "id": "controls_inventory", "name": "Inventory", "topic": "controls", "action": "inventory", "text": "Open your inventory with {key:inventory}. Crafting is listed there for whatever stations are nearby." },
    { "id": "controls_map", "name": "World map", "topic": "controls", "action": "map", "text": "Press {key:map} for the world map. Only what you have explored is shown." },
    { "id": "controls_grapple", "name": "Grappling", "topic": "controls", "action": "grapple", "text": "With a grappling hook equipped, press {key:grapple} to fire it and pull yourself up." },
    { "id": "controls_camera", "name": "Camera", "topic": "controls", "action": "toggle_camera", "text": "Switch between first and third person with {key:toggle_camera}." },
    { "id": "controls_crouch", "name": "Crouching", "topic": "controls", "action": "crouch", "text": "Hold {key:crouch} to crouch, drop through platforms and avoid walking off ledges." },
    { "id": "controls_drop", "name": "Dropping items", "topic": "controls", "action": "drop_item", "text": "Press {key:drop_item} to throw the held item on the ground." },
    { "id": "controls_hotbar", "name": "Hotbar", "topic": "controls", "action": "hotbar_1", "text": "Pick a hotbar slot with {key:hotbar_1} to {key:hotbar_10}, or scroll with {key:hotbar_next} and {key:hotbar_prev}." },
    { "id": "controls_precision", "name": "Precision building", "topic": "controls", "action": "precision_mode", "text": "Hold {key:precision_mode} for precise placement; {key:rotate_shape} rotates and {key:cycle_shape} changes a block's shape." },
    { "id": "controls_pause", "name": "Pausing", "topic": "controls", "action": "pause", "text": "Press {key:pause} to open the menu; the game saves when you leave." },
    { "id": "building_house", "name": "A valid house", "topic": "building", "text": "A house needs walls all around, a door, a light source, a table and a chair. Each townsperson needs a house of their own." },
    { "id": "building_stations", "name": "Crafting stations", "topic": "building", "text": "Recipes need stations nearby: a Work Bench, Furnace, Anvil, Sawmill, Loom and more. Keep them together in your base." },
    { "id": "building_platforms", "name": "Platforms", "topic": "building", "text": "Wooden platforms are cheap stairs: you can jump up through them and drop down through them." },
    { "id": "building_torches", "name": "Light", "topic": "building", "text": "Monsters spawn in the dark. Torches keep your house safe and the caves visible." },
    { "id": "building_bed", "name": "Beds", "topic": "building", "text": "Use a bed to set your spawn point. You respawn there after dying." },
    { "id": "building_chests", "name": "Storage", "topic": "building", "text": "Chests hold forty stacks each. A Piggy Bank keeps its contents everywhere you place one." },
    { "id": "combat_life", "name": "Life", "topic": "combat", "text": "Life Crystals raise your maximum life by 20 up to 400; Life Fruit from the hardmode jungle goes beyond." },
    { "id": "combat_armor", "name": "Armor", "topic": "combat", "text": "Armor gives defense; a full matching set grants a bonus as well." },
    { "id": "combat_potions", "name": "Potions", "topic": "combat", "text": "Healing potions restore life at once, but you must wait a while before drinking another." },
    { "id": "combat_night", "name": "Night", "topic": "combat", "text": "Zombies and Demon Eyes roam at night. Stay inside until morning if you are not ready." },
    { "id": "combat_bosses", "name": "Bosses", "topic": "combat", "text": "Bosses are summoned with special items or by breaking certain objects. Build an arena with platforms before you fight." },
    { "id": "combat_ranged", "name": "Ranged weapons", "topic": "combat", "text": "Bows and guns need ammunition. Keep arrows or bullets in your ammo slots." },
    { "id": "combat_magic", "name": "Magic", "topic": "combat", "text": "Magic weapons spend mana. Mana Crystals raise your maximum, and mana regenerates when you stop casting." },
    { "id": "combat_summon", "name": "Summoning", "topic": "combat", "text": "Summoning staves call minions that fight for you while you keep moving." },
    { "id": "town_happiness", "name": "Happiness", "topic": "town", "text": "Townsfolk like some neighbours and biomes and dislike others. Happy residents sell for less." },
    { "id": "town_nurse", "name": "The Nurse", "topic": "town", "text": "The Nurse will heal you for a fee once you have raised your maximum life." },
    { "id": "town_merchant", "name": "The Merchant", "topic": "town", "text": "The Merchant moves in once you carry 50 silver coins. He sells torches, rope and other basics." },
    { "id": "town_arrivals", "name": "Moving in", "topic": "town", "text": "New townsfolk arrive when their conditions are met and a free house is waiting." },
    { "id": "town_sell", "name": "Selling", "topic": "town", "text": "Residents with a shop buy your unwanted items for a fifth of their value." },
    { "id": "exploration_layers", "name": "Layers", "topic": "exploration", "text": "Below the surface lie the underground, the caverns and, at the very bottom, the Underworld." },
    { "id": "exploration_biomes", "name": "Biomes", "topic": "exploration", "text": "Each biome has its own creatures, materials and treasures: the jungle, the snow, the desert, the ocean and more." },
    { "id": "exploration_evil", "name": "The evil biome", "topic": "exploration", "text": "The Corruption or the Crimson spreads slowly. Purification Powder and walls of stone or dirt can hold it back." },
    { "id": "exploration_chests", "name": "Chests", "topic": "exploration", "text": "Chests are hidden throughout the world. Gold Chests in the caverns often hold accessories." },
    { "id": "exploration_pots", "name": "Pots", "topic": "exploration", "text": "Break pots in caves for coins, torches, potions and other supplies." },
    { "id": "exploration_fishing", "name": "Fishing", "topic": "exploration", "text": "Fish with a rod and bait in any pool of water. Crates and the Angler's quests reward patient fishers." },
    { "id": "exploration_mirror", "name": "Getting home", "topic": "exploration", "text": "A Magic Mirror or a Recall Potion takes you straight back to your spawn point." }
  ]
}
