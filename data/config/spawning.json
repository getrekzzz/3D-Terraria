{
  // Natural enemy spawning around players (see SpawnDirector). Distances in metres, intervals in ticks (60/s).
  // About one attempt every 10 s, day and night. The reference game spawns faster at night, but here night
  // creatures close in from every side at once, so nights keep the day's pace and a smaller allowance.
  "checkInterval": 60,
  // Town defence (P5-09): hostile creatures go after residents within residentAggroRange when no player is
  // playerPreference metres nearer.
  "residentAggroRange": 14,
  "playerPreference": 4,
  "chance": 0.10,
  "nightChance": 0.10,
  // Hostile creatures near a player (a group is cut short rather than go over); critters (fireflies, bunnies…)
  // have their own small allowance. Creatures count until they despawn (countRadius matches the despawn
  // distance), so the ones a player walks away from still count while they follow.
  "maxNearbyDay": 4,
  "maxNearbyNight": 3,
  "maxCritters": 3,
  "countRadius": 90,
  "minDistance": 22,
  "maxDistance": 46,
  "attempts": 12,
  // Inside a zone with its own roster (the crypt) creatures appear closer, among its halls.
  "zoneMinDistance": 9,
  "zoneMaxDistance": 24,
  // Safe ground: no hostile creature appears within safeRadius of the world spawn or a bed, nor on the surface
  // where placed lights reach safeLight (torches keep a camp safe; world events ignore the light).
  "safeRadius": 30,
  "safeLight": 8,
  // A town: townResidents housed residents within townRadius. Every living resident nearby (homeless or not)
  // slows natural spawning by townFactors[count] (the last entry for that many or more); events ignore it.
  "townResidents": 2,
  "townRadius": 40,
  "townFactors": [1, 0.5, 0.25, 0.1]
}
