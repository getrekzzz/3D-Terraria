{
  // Natural enemy spawning around players (see SpawnDirector). Distances in metres, intervals in ticks (60/s).
  // Rates follow the reference game: about one attempt every 10 s by day and every 6 s at night.
  "checkInterval": 60,
  "chance": 0.10,
  "nightChance": 0.17,
  // Hostile creatures near a player; critters (fireflies, bunnies…) have their own small allowance.
  "maxNearbyDay": 4,
  "maxNearbyNight": 5,
  "maxCritters": 3,
  "countRadius": 60,
  "minDistance": 22,
  "maxDistance": 46,
  "attempts": 12,
  // Inside a zone with its own roster (the crypt) creatures appear closer, among its halls.
  "zoneMinDistance": 9,
  "zoneMaxDistance": 24,
  // Safe ground: no hostile creature appears within safeRadius of the world spawn or a bed, nor on the surface
  // where placed lights reach safeLight (torches keep a camp safe; world events ignore the light).
  "safeRadius": 30,
  "safeLight": 8,
  // A town: townResidents housed residents within townRadius. Every living resident nearby (homeless or not)
  // slows natural spawning by townFactors[count] (the last entry for that many or more); events ignore it.
  "townResidents": 2,
  "townRadius": 40,
  "townFactors": [1, 0.5, 0.25, 0.1]
}
