{
  // What creatures are made of (src/Strata.Core/Presentation/CreatureMaterialsConfig.cs): the sound of a hit and of a
  // death, the dust a hit throws (an EffectKit recipe: Chips, Dust, Sparks, Puff, Splash, Leaves; useTint takes the
  // creature's tint) and the gore of a death (pieces, colour, box or sphere). An enemy's own "material" wins, then its
  // model, then its tags; anything else is flesh. Its own hitSound/deathSound override the material's.
  "materials": {
    "flesh":  { "hitSound": "hit", "deathSound": "npc_death", "dust": { "recipe": "Dust", "color": "#a01818" }, "gore": { "pieces": 3, "color": "#8a2424", "shape": "box" } },
    "gel":    { "hitSound": "hit_squish", "deathSound": "slime_death", "dust": { "recipe": "Splash", "useTint": true }, "gore": { "pieces": 3, "useTint": true, "shape": "sphere" } },
    "bone":   { "hitSound": "hit_bone", "deathSound": "death_bone", "dust": { "recipe": "Chips", "color": "#e8e0c8" }, "gore": { "pieces": 4, "color": "#e4dcc4", "shape": "box" } },
    "metal":  { "hitSound": "hit_metal", "deathSound": "death_metal", "dust": { "recipe": "Sparks", "color": "#ffd080" }, "gore": { "pieces": 4, "color": "#8a8e96", "shape": "box" } },
    "plant":  { "hitSound": "hit_plant", "deathSound": "death_plant", "dust": { "recipe": "Leaves", "color": "#5a9a3a" }, "gore": { "pieces": 3, "color": "#4a7a2a", "shape": "box" } },
    "stone":  { "hitSound": "hit_stone", "deathSound": "death_stone", "dust": { "recipe": "Chips", "color": "#80808a" }, "gore": { "pieces": 4, "color": "#6a6a74", "shape": "box" } },
    "spirit": { "hitSound": "hit_spirit", "deathSound": "death_spirit", "dust": { "recipe": "Sparks", "useTint": true }, "gore": { "pieces": 0, "shape": "sphere" } },
    "chitin": { "hitSound": "hit_chitin", "deathSound": "death_chitin", "dust": { "recipe": "Chips", "useTint": true }, "gore": { "pieces": 3, "useTint": true, "shape": "box" } }
  },
