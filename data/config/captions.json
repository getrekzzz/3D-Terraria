{
  // Subtitles for sounds (X-12; Settings > Accessibility > Subtitles): the line shown above the chat log when a listed
  // sound plays, coloured by its kind. Positional sounds farther than their range (metres) are not captioned and get an
  // arrow pointing to where they came from. Weather loops are captioned while they can be heard.
  "seconds": 3,
  "fadeSeconds": 0.6,
  "maxLines": 5,
  "range": 32,
  "colors": {
    "world": "#ffffff",
    "boss": "#af4bff",
    "enemy": "#ffaa78",
    "town": "#327dff",
    "weather": "#96d2ff"
  },
  "sounds": {
