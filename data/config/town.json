{
  // Town tuning (see Gameplay/Town). Ticks are 1/60 s; distances in meters.
  "arrivalInterval": 600,
  "homeCheckInterval": 900,
  "respawnTicks": 21600,
  "respawnAtDawn": true,
  "minDeadTicks": 1800,
  // Terraria 1.4 happiness (Gameplay/Town/TownHappiness): price multipliers for loved/liked/disliked/hated biomes and
  // neighbours; radii in metres (25 and 120 tiles); more than crowdLimit near neighbours cost crowdStep each.
  "happiness": { "love": 0.88, "like": 0.94, "dislike": 1.06, "hate": 1.12, "nearRadius": 12.5, "farRadius": 60, "verticalCap": 15,
    "crowdLimit": 3, "crowdStep": 0.05, "solitudeNear": 2, "solitudeFar": 4, "solitude": 0.95, "homeless": 1.1 },
  // Biome pylons (Gameplay/Town/PylonNetwork, P5-34): a resident content or happier (price factor <= maxFactor) with
  // another resident within neighbourRadius sells the pylon of the biome their home is in (10 gold before happiness).
  // A pylon works with 2+ residents within activeRadius; the player teleports from within useRadius of a working one.
  "pylons": { "price": 100000, "maxFactor": 1.0, "neighbourRadius": 12.5, "activeRadius": 40, "minResidents": 2, "useRadius": 30,
    "rules": [
      { "object": "hallow_pylon", "biome": "hallow" },
      { "object": "mushroom_pylon", "biome": "mushroom" },
      { "object": "jungle_pylon", "biome": "jungle" },
      { "object": "desert_pylon", "biome": "desert" },
      { "object": "snow_pylon", "biome": "tundra" },
      { "object": "ocean_pylon", "biome": "ocean" },
      { "object": "forest_pylon", "biome": "forest" },
      { "object": "cavern_pylon", "layer": "underground" }
    ] },
  // Emote bubbles and voices (Gameplay/Town/TownSystem.Emotes, X-05): a few residents are checked every interval; a ready
  // one shows a bubble with the given chance, then waits cooldownMin..cooldownMax ticks. Voice blips (sfx voice_*,
  // tools/audio/sfx_recipes_town.py) play when a conversation starts, pitched per resident.
  "emotes": { "interval": 30, "residentsPerCheck": 2, "chance": 0.25, "cooldownMin": 600, "cooldownMax": 1800, "bubbleTicks": 150,
    "chatRadius": 4, "replyRadius": 10,
    "voices": {
      "guide": { "sound": "voice_mid", "pitch": 1.0 },
      "merchant": { "sound": "voice_old", "pitch": 1.05 },
      "nurse": { "sound": "voice_high", "pitch": 1.05 },
      "demolitionist": { "sound": "voice_gruff", "pitch": 0.95 },
      "dye_trader": { "sound": "voice_mid", "pitch": 0.9 },
      "angler": { "sound": "voice_child", "pitch": 1.1 },
      "zoologist": { "sound": "voice_high", "pitch": 1.1 },
      "dryad": { "sound": "voice_high", "pitch": 1.15 },
      "painter": { "sound": "voice_mid", "pitch": 1.05 },
      "golfer": { "sound": "voice_mid", "pitch": 0.95 },
      "arms_dealer": { "sound": "voice_low", "pitch": 1.0 },
      "stylist": { "sound": "voice_high", "pitch": 0.95 },
      "goblin_tinkerer": { "sound": "voice_squeak", "pitch": 1.0 },
      "witch_doctor": { "sound": "voice_low", "pitch": 0.9 },
      "clothier": { "sound": "voice_old", "pitch": 0.95 },
      "mechanic": { "sound": "voice_high", "pitch": 1.0 },
      "party_girl": { "sound": "voice_child", "pitch": 1.0 },
      "tavernkeep": { "sound": "voice_gruff", "pitch": 1.05 },
      "old_man": { "sound": "voice_old", "pitch": 0.85 },
      "travelling_merchant": { "sound": "voice_old", "pitch": 1.0 },
      "skeleton_merchant": { "sound": "voice_bones", "pitch": 1.0 },
      "wizard": { "sound": "voice_old", "pitch": 0.9 },
      "truffle": { "sound": "voice_fungus", "pitch": 1.0 },
      "tax_collector": { "sound": "voice_old", "pitch": 0.8 },
      "pirate": { "sound": "voice_gruff", "pitch": 0.85 },
      "steampunker": { "sound": "voice_high", "pitch": 0.9 },
      "cyborg": { "sound": "voice_robot", "pitch": 1.0 },
      "santa_claus": { "sound": "voice_low", "pitch": 0.85 },
      "princess": { "sound": "voice_high", "pitch": 1.2 },
      "town_cat": { "sound": "voice_cat", "pitch": 1.0 },
      "town_dog": { "sound": "voice_dog", "pitch": 1.0 },
      "town_bunny": { "sound": "voice_bunny", "pitch": 1.0 }
    } },
  "minPriceFactor": 0.75,
  "maxPriceFactor": 1.5,
  "sellRatio": 0.2,
  "wanderRadius": 8,
  "landmarkRadius": 3,
  "idleTicksMin": 180,
  "idleTicksMax": 540,
  "talkRange": 5,
  "talkTicks": 900
}
