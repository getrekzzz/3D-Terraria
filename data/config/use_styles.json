                                     { "t": 0.42, "pos": [-0.16, -0.05, -0.05], "rot": [-50.1, -24.6, 17.2] },
                                     { "t": 1, "pos": [0.03, 0.06, -0.03], "rot": [37.2, 8.6, -17.2] }] } },
    "rapier": { "clip": "rapier", "sound": "swing", "armAim": 1,
                "fp": { "rest": { "pos": [0, 0, 0], "rot": [-20, 14.3, 8.6] }, "curve": "extend" } },
    "spear":  { "clip": "spear", "sound": "swing", "armAim": 1,
