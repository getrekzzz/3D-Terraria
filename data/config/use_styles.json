    "gun":    { "clip": "gun", "sound": "gun", "heavySound": "gun_heavy", "armAim": 1, "muzzleFlash": true, "holdout": { "forward": 0.55, "right": 0.22, "down": 0.25 },
                "fp": { "rest": { "pos": [-0.1, 0.1, 0.08], "rot": [90, 180, 0] }, "aimAtCrosshair": true,
