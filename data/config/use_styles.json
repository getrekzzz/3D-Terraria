    "tome":   { "clip": "tome", "sound": "magic", "heavySound": "magic_heavy", "armAim": 1, "tipSparks": true, "holdout": { "forward": 0.4, "right": 0.1, "down": 0.2 },
                "fp": { "rest": { "pos": [-0.04, -0.02, 0], "rot": [-54.4, 14.3, 0] }, "aimAtCrosshair": true,
                        "keys": [{ "t": 0, "ease": "lin" }, { "t": 0.12, "pos": [-0.01, 0.01, -0.08], "rot": [-8.6, 0, 0], "ease": "out" },
                                 { "t": 0.3, "pos": [-0.01, 0.01, -0.08], "rot": [-8.6, 0, 0], "ease": "lin" }, { "t": 1 }] } },
    "throw":  { "clip": "throw", "sound": "throw", "armAim": 0.5, "holdout": { "forward": 0.3, "right": 0.25, "down": 0.1 },
                "fp": { "rest": { "pos": [0, 0, 0], "rot": [-20, 14.3, 8.6] }, "curve": "blade" } },
    "yoyo":   { "clip": "yoyo", "sound": "yoyo_throw", "armAim": 1,
                "fp": { "rest": { "pos": [0, 0, 0], "rot": [-20, 14.3, 8.6] }, "keys": [{ "t": 0, "ease": "lin" }, { "t": 0.15, "pos": [-0.08, 0.06, -0.12], "rot": [-50, 0, 0], "ease": "out" },
