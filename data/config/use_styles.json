                "fp": { "rest": { "pos": [-0.2, 0.18, -0.07], "rot": [-10.3, -90, 0] }, "aimAtCrosshair": true,
                        "recoil": { "pos": [0, 0, -0.03], "rot": [0, 0, 0], "decay": 0.2 } } },
    "staff":  { "clip": "staff", "sound": "magic", "heavySound": "magic_heavy", "armAim": 1, "tipSparks": true, "holdout": { "forward": 0.9, "right": 0.2, "down": 0.1 },
                "hand": { "offset": [0, 0.08, 0], "euler": [60, 0, 0] },
                "fp": { "rest": { "pos": [-0.04, -0.02, 0], "rot": [-54.4, 14.3, 0] }, "aimAtCrosshair": true,
                        "keys": [{ "t": 0, "ease": "lin" }, { "t": 0.12, "pos": [-0.01, 0.01, -0.08], "rot": [-8.6, 0, 0], "ease": "out" },
