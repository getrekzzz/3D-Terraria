# Hardmode: the Mawwall's defeat raises hardmode; its world mutations join the log, loaded chunks catch up as edits,
# newly streamed chunks arrive mutated, the radiant wedge is a zone, and the changed biomes spread.
wait_until player.frozen == 0 180
spawning off
town arrivals off
assert mutation.level == 0
flag defeated_wall_of_flesh
assert flag.hardmode == 1
assert mutation.level == 3
# Each altar smashed with a Pwnhammer seeds the next tier of ore.
flag smashed_altar_1
assert mutation.level == 4
wait_until mutation.behind == 0 60
mutations

# Travel to where the radiant wedge meets the surface: new chunks stream in already converted.
tp zone hallow
wait_until player.frozen == 0 300
wait_until stream.idle == 1 600
assert zone.hallow == 1
assert mutation.behind == 0
mutations spread 20
assert spread.conversions >= 0
assert errors == 0

# Hardmode life: the new stations place; every new creature spawns, moves and renders (ranged ones shoot).
god
fill -10 -3 -10 10 -1 10 pearlstone
fill -10 0 -10 10 10 10 air
place hellforge 4 0 4
place mythril_anvil -4 0 4
place adamantite_forge -4 0 -5
wait 0.5
spawn pixie 1
spawn unicorn 1
spawn illuminant_slime 1
spawn chaos_elemental 1
spawn corruptor 1
spawn corrupt_slime 1
spawn crimslime 1
spawn ichor_sticker 1
spawn floaty_gross 1
spawn armored_skeleton 1
spawn wraith 1
spawn giant_bat 1
assert npcs.count >= 12
wait 3
assert npcs.unicorn == 1
assert errors == 0
killall
assert errors == 0

# P4-25: the Demon Heart (Expert-only: refused here without errors) and a hardmode treasure bag opening.
give demon_heart 1
wield demon_heart
use
wait 0.5
give plantera_treasure_bag 1
wield plantera_treasure_bag
use
wait 0.5
assert inv.plantera_treasure_bag == 0
assert errors == 0
