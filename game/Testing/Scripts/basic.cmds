# Engine smoke test: boot, stream, land, walk, mine, collect, place, craft-free building, time, save.
# Runs with: godot --headless --path . -- --world=smoke --size=tiny --new --player=smoke --fresh-player --view=2 --smoke=res://game/Testing/Scripts/basic.cmds

wait_until player.frozen == 0 180
wait 1.5
assert errors == 0
assert player.alive == 1
assert player.on_floor == 1
assert colliders.bodies > 0
assert chunks.meshed > 8

# Every command documents itself.
help
probes

# Walking moves the body across the terrain.
mark
aim 0 0 1
hold move_forward 1.2
wait 0.3
assert player.from_mark > 1.5
assert player.on_floor == 1

# A flat stone arena around the player makes the rest independent of the terrain.
fill -10 -3 -10 10 -1 10 stone
fill -10 0 -10 10 7 10 air
wait 1.0
assert player.on_floor == 1

# Mining the stone floor drops stone that we collect.
wield copper_pickaxe
aim 0.05 -1 0.05
hold use_primary 2.5
wait 1.5
assert inv.stone >= 8
probe player.cell_y
probe player.y
probe block.0.-1.0
assert player.alive == 1

# Building: place a brick on the floor in front of us.
fill -10 -3 -10 10 -1 10 stone
wait 0.5
give stone_brick 20
wield stone_brick
aim 0 -0.8 1
use
assert player.held_count == 19
fill 2 0 -1 2 3 1 stone_brick
assert block.2.1.0 > 0

# Tile objects: a torch on the floor, a workbench from the item.
probe player.y
probe block.0.0.3
probe block.0.-1.3
place torch -2 0 -3
assert objects.count > 0
give workbench 1
wield workbench
aim -0.6 -0.5 -1
use
assert inv.workbench == 0
assert objects.count > 0

# Time of day affects lighting (no errors while switching).
time midnight
wait 0.5
assert time.day == 0
time noon
assert time.day == 1

save
inspect
assert errors == 0
