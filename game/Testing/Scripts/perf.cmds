# Perf smoke: the usual hitch sources (far travel, a save, torches, flowing water, magic, creatures) with the frame
# profiler on, then `perf report` and `perf spikes`. Headless CI asserts only deterministic counters (frames closed,
# work that must have happened); wall-clock thresholds belong to the rendering run, whose output is the baseline:
#   godot --path . --rendering-driver vulkan -- --world=perf --size=small --new --player=perf --fresh-player \
#         --view=6 --graphics=medium --smoke=res://game/Testing/Scripts/perf.cmds
# Runs with: godot --headless --path . -- --world=smoke-perf --size=tiny --new --player=smoke --fresh-player --view=2 --smoke=res://game/Testing/Scripts/perf.cmds

wait_until player.frozen == 0 300
wait_until stream.idle == 1 900
spawning off
town arrivals off
perf start

# Travel: each jump streams a whole new area in (loads, meshes, colliders, tile objects, grass).
biome desert
wait_until player.frozen == 0 300
wait_until stream.idle == 1 900
biome tundra
wait_until player.frozen == 0 300
wait_until stream.idle == 1 900
tp spawn
wait_until player.frozen == 0 300
wait_until stream.idle == 1 900
assert perf.frames > 0
assert perf.calls.gd.colliders.build > 0
# Streaming and job completions stay inside the frame budgets (12 ms while loading, 3-5 ms in play). Generous
# headless bound; the rendering run shows the real per-frame average.
probe perf.avg.gd.stream_and_jobs
assert perf.avg.gd.stream_and_jobs < 14
probe perf.gc2
probe perf.calls.stream.unload_flush
probe perf.max.stream.unload_flush

# A full synchronous save (Save & Quit), then the autosave path: captured on the main thread, written in the background.
save
setblock 3 0 3 stone
save async
wait 1
wait_until save.in_flight == 0 300
assert perf.calls.tick.autosave > 0
probe perf.max.tick.autosave
probe perf.max.stream.unload_flush

# A flat arena, then ten torches, one per frame (remeshes, collider and tile-object rebuilds, light).
fill -10 -3 -10 10 -1 10 stone
fill -10 0 -10 10 7 10 air
wait 1.0
colliders reset
place torch -8 0 -8
place torch -4 0 -8
place torch 0 0 -8
place torch 4 0 -8
place torch 8 0 -8
place torch -8 0 8
place torch -4 0 8
place torch 0 0 8
place torch 8 0 8
place torch -8 0 0
wait 1.0
assert objects.count >= 10
# Light-only remeshes keep the collision geometry: (almost) no collider rebuilds.
probe colliders.skipped
assert colliders.rebuilt <= 2
assert perf.calls.gd.objects.rebuild > 0
# Tile objects: one regroup per torch chunk and edit, light-only remeshes rewrite light in place.
probe objects.rebuilds
probe objects.light_refreshes
assert objects.rebuilds <= 14
assert objects.light_refreshes > 0
probe perf.max.gd.objects

# Water pours onto the floor and spreads.
liquid water 3 0 3 5 2 5
wait 3

# Magic: twenty sparks (mana refilled halfway).
give wand_of_sparking 1
wield wand_of_sparking
aim 0 0 1
repeat 10 use
heal
repeat 10 use
wait 1.0
assert perf.calls.gd.projectiles.create > 0

# Creatures appear (models instantiated on first sight).
spawn zombie 5
spawn demon_eye 3
wait 2.0
assert perf.calls.gd.npcs.create > 0

perf report 40
perf spikes 10
probe perf.frames
probe perf.frames_over_33
probe perf.frames_over_50
probe perf.worst_ms
probe perf.p99_ms
probe perf.gc2
probe perf.gc_pause_ms
probe perf.calls.tick.autosave
assert errors == 0

# One block edit from a fresh profile: what a single edit rebuilds (later work packages bound these).
killall
perf start
setblock 6 0 -4 stone
wait 1.0
probe perf.calls.gd.colliders.build
probe perf.calls.gd.objects.rebuild
probe perf.max_calls.gd.grass.create
assert errors == 0
