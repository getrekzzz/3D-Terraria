# Town: the starter guide, a player-built home, move-in, walking home at night through the door, talking and trading.
wait_until player.frozen == 0 180
spawning off
time noon
town arrivals off
fill -16 -3 -16 16 -1 16 stone
fill -16 0 -16 16 10 16 air
wait 0.5
assert town.guide == 1
assert errors == 0

# A home east of the player: brick shell, door opening, then furniture.
fill 3 0 -5 13 6 5 gray_brick
fill 4 0 -4 12 5 4 air
fill 8 0 -5 9 3 -5 air
place wooden_door 8 0 -5
place torch 4 0 4
place wooden_table 9 0 1
place wooden_chair 5 0 1
house 8 1 0

# The guide waits outside, is housed by the move-in check, and walks home at night (opening the door).
town dismiss guide
town summon guide 8 0 -10
town check
assert town.homed == 1
town
time 21
wait_until town.guide.home < 0.8 60
wait 2
assert town.guide.home < 0.3
time noon

# --- P5-01 ---
# A slain resident stays dead through the night and returns at dawn.
town slay guide
assert town.guide.alive == 0
time 3
wait 1
assert town.guide.alive == 0
time 5
wait_until town.guide.alive == 1 10
time noon

# --- P5-02 ---
# Corruption under the house makes it invalid ("This housing is corrupted."); cleansed, the guide moves back in.
fill 3 -3 -5 13 -2 5 ebonstone
wait_until town.guide.home < 0 20
fill 3 -3 -5 13 -2 5 stone
town check force
assert town.homed == 1

# --- P5-03 ---
season christmas
assert season.id == 2
season off
assert season.id == 0
season auto

# --- P5-05 ---
# The housing API: evict the guide (the room reads suitable again), then assign him back.
housing evict guide
assert town.guide.homed == 0
housing query 8 1 0
housing assign guide 8 1 0
assert town.guide.homed == 1

# --- P5-13 ---
# The Dryad's Status service reports the world's purity (the chat button arrives with the W4 dialog).
town summon dryad 0 0 -3
town services dryad
town status dryad
# --- P5-15 ---
# The Dryad sells Terraria's grass seeds.
give copper_coin 30
town buy dryad grass_seeds
assert inv.grass_seeds == 1
town dismiss dryad
# --- P5-16 ---
# The Painter's paintings are under his Decor tab; the Tavernkeep takes Defender Medals for Ale.
town summon painter 2 0 -3
give copper_coin 99
give silver_coin 14
town buy painter land
assert inv.land == 1
town dismiss painter
give defender_medal 3
town summon tavernkeep 2 0 -3
town buy tavernkeep ale
assert inv.ale == 1
assert inv.defender_medal == 2
town dismiss tavernkeep
# Back to the starting kit's 25 torches and an empty purse for the trading checks below.
clear
give torch 25
assert errors == 0

# Talking and trading with the peddler.
give silver_coin 60
town summon merchant 0 0 -3
wait 0.2
# The crosshair names him with his life (P1-07), and right-click talks to the resident under it.
camera first
aim 0 0 -1
wait 0.3
assert hover.resident == 1
assert hover.talk == 1
assert hud.target_name.the_merchant_250/250 == 1
hold use_secondary 0.1
assert ui.talk_open == 1
ui close
camera third
town talk merchant
ui talk merchant
ui shop
town buy merchant torch
# 25 from the starting kit (PlayerState) + 1 bought.
assert inv.torch == 26
ui close
assert errors == 0

# --- P2-06 ---
# The purchase was paid from the coin slots. Coins fly into the coin slots, 100 of one become 1 of the next, and the
# purse counts every slot; arrows fill the ammo slots and still count as carried.
assert inv.coins < 6000
assert inv.coins > 0
clear
give copper_coin 250
assert inv.silver_coin == 2
assert inv.copper_coin == 50
assert inv.coins == 250
give wooden_arrow 30
assert inv.wooden_arrow == 30
assert errors == 0

# --- P5-19 ---
# The Travelling Merchant walks in (forced), trades from his rotating stock and walks off again.
town visit travelling_merchant
wait 0.5
assert town.travelling_merchant == 1
ui talk travelling_merchant
ui shop
ui close
town leave travelling_merchant
assert errors == 0
