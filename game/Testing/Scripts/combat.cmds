# Combat smoke test: creatures spawn, chase and damage the player; melee, bows and loot work; respawn works.
wait_until player.frozen == 0 180
spawning off
killall
fill -10 -3 -10 10 -1 10 stone
fill -10 0 -10 10 7 10 air
wait 1.0
heal
assert npcs.count == 0

# A gel attacks: contact damage with invulnerability frames.
spawn green_gel 1 3
wait_until player.life < 100 12
assert npcs.green_gel == 1

# Kill it with a sword; it drops gel.
wield copper_shortsword
aim 0 -0.2 1
repeat 12 use
wait 1.5
killall
heal

# Arrows fly and hit.
give wooden_bow 1
give wooden_arrow 50
wield wooden_bow
spawn shambler 1 8
aim 0 0.02 1
use
assert projectiles.count >= 1
wait 1.0
assert inv.wooden_arrow == 49

# Death and respawn.
killall
kill
wait 0.5
assert player.alive == 0
wait_until player.alive == 1 10
assert player.deaths >= 1
assert errors == 0
