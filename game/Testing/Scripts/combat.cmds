# Combat smoke test: creatures spawn, chase and damage the player; melee, swords that shoot, Zenith, bows and loot
# work; respawn works.
wait_until player.frozen == 0 180
spawning off
# The starter guide would shoot the test creatures (P5-10); town.cmds covers residents fighting back.
town defense off
killall
fill -10 -3 -10 10 -1 10 stone
fill -10 0 -10 10 7 10 air
wait 1.0
heal
assert npcs.count == 0

# A gel attacks: contact damage with invulnerability frames.
spawn green_slime 1 3
wait_until player.life < 100 12
assert npcs.green_slime == 1

# Kill it with a sword; it drops gel.
wield copper_shortsword
aim 0 -0.2 1
repeat 12 use
wait 1.5
killall
heal

# A sword that shoots still swings: one use starts a blade swing and a star; the frozen slime at 2 m dies.
give starfury 1
wield starfury
killall
aim 0 0 1
spawn green_slime 1 2
ai off
use
assert melee.swings == 1
assert projectiles.count >= 1
wait 0.6
assert npcs.alive_life < 14
ai on
killall

# Zenith never blocks: a second use throws three more blades while the first three are still out.
wait_until projectiles.count == 0 5
give zenith 1
wield zenith
use
use
assert projectiles.count >= 6
assert melee.swings == 0
wait_until projectiles.count == 0 5

# Arrows fly and hit.
give wooden_bow 1
give wooden_arrow 50
wield wooden_bow
spawn zombie 1 8
aim 0 0.02 1
use
assert projectiles.count >= 1
wait 1.0
assert inv.wooden_arrow == 49

# P3-09': Starfury swings and rains a star from the sky onto the crosshair.
killall
give starfury 1
wield starfury
spawn zombie 1 3
aim 0 0 1
use
wait 0.05
assert projectiles.count >= 1
wait 1
killall
assert errors == 0

# P3-14: a leather whip lashes the zombie ahead (and tags it for minions).
give leather_whip 1
wield leather_whip
spawn zombie 1 3
aim 0 0 1
use
wait 0.8
assert whips.hits >= 1
killall
assert errors == 0

# Death and respawn.
killall
kill
wait 0.5
assert player.alive == 0
assert avatar.ragdoll == 1
wait_until player.alive == 1 10
wait 0.1
assert avatar.ragdoll == 0
assert player.deaths >= 1
assert errors == 0

# --- P1-10 ---
# Use time vs animation: a held pickaxe plays whole 21-tick swings and digs on its own 15-tick cadence inside them
# (one second is three swings; restarting the swing on every dig would make it four); the wooden sword swings for
# 25 ticks, and Feral Claws (+12 % melee speed) shorten the whole swing to 22.
fill -10 -3 -10 10 -1 10 stone
fill -10 0 -10 10 7 10 air
give copper_pickaxe 1
wield copper_pickaxe
aim 0.05 -1 0.05
mark
hold use_primary 1
assert player.use_anim == 21
assert player.swings == 3
give wooden_sword 1
wield wooden_sword
aim 0 0 1
use
assert player.use_anim == 25
equip feral_claws
use
assert player.use_anim == 22
assert melee.swings == 1
assert errors == 0

# --- P1-15 ---
# A bow with no arrows: the fresh press is reported once (a dry click and 'Needs Wooden Arrow'); holding the button
# down reports its own fresh press and nothing more.
clear
give wooden_bow 1
wield wooden_bow
assert use.failures == 0
use
assert use.failures == 1
hold use_primary 0.5
assert use.failures == 2
assert errors == 0

# --- P1-06 ---
# The body faces the crosshair and nothing behind the player is the target. In third person a pickaxe (it selects
# decor) targets the wall ahead, never the stalagmites right behind the player that the shoulder camera's ray passes
# through when looking up. The chest stays on the camera's yaw standing, with the camera swung round the player (the
# orbit keeps the aim), strafing (the legs turn 45 degrees toward the move and play strafe_left) and backpedalling.
killall
heal
fill -10 -3 -10 10 -1 10 stone
fill -10 0 -10 10 7 10 air
camera third
give copper_pickaxe 1
wield copper_pickaxe
fill -2 0 6 2 5 6 stone
aim 0 0 1
wait 0.3
assert target.front == 1
assert target.dist > 2
assert player.facing_error_deg < 3
place stalagmite -2 0 -3
place stalagmite -1 0 -3
place stalagmite 0 0 -3
place stalagmite -2 0 -2
place stalagmite -1 0 -2
place stalagmite 0 0 -2
aim 0 0.3 1
wait 0.3
assert target.front == 1
assert target.dist > 2
assert player.facing_error_deg < 3
camera orbit 90
wait 0.3
assert target.front == 1
assert target.dist > 2
assert player.facing_error_deg < 3
camera orbit 0
aim 0 0 1
press move_left
wait 0.4
assert player.stride == 1
assert player.twist_deg < -40
assert player.twist_deg > -50
assert player.facing_error_deg < 3
release move_left
press move_back
wait 0.4
assert player.stride == 3
assert player.twist_deg > -5
assert player.twist_deg < 5
assert player.facing_error_deg < 3
release move_back
wait 0.3
# The crosshair point shots converge on is the terrain the view rests on past the reach (a wall 15 m ahead), not a
# fixed 40 m away.
fill -10 0 -10 10 7 10 air
fill -3 0 11 3 8 29 air
fill -3 0 30 3 8 30 stone
aim 0 0 1
wait 0.2
assert player.aim_distance > 14
assert player.aim_distance < 16
fill -3 0 11 3 8 30 air
camera first
assert errors == 0

# --- P1-07 ---
# A creature under the crosshair is named with its life at any distance, a wall in front hides it, and with no
# creature hovered the label names the block in reach.
killall
heal
fill -10 -3 -10 10 -1 10 stone
fill -10 0 -10 10 7 10 air
camera first
wield copper_pickaxe
aim 0 0 1
spawn blue_slime 1 4
ai off
aim 0 -0.25 1
wait 0.3
assert hover.npc == 1
assert hover.blue_slime == 1
assert hud.target_name == 1
assert hud.target_name.blue_slime_25/25 == 1
fill -2 0 3 2 4 3 stone
wait 0.2
assert hover.npc == 0
assert hud.target_name.blue_slime == 0
assert hud.target_name.stone == 1
fill -2 0 3 2 4 3 air
ai on
killall
camera third
assert errors == 0

# --- P1-11 ---
# Chained uses flow: held down, a sword autoswings and a pickaxe chops one use straight into the next without the
# body's upper-body action fading toward the locomotion pose in between; it fades out only once the button is let go.
killall
heal
fill -10 -3 -10 10 -1 10 stone
fill -10 0 -10 10 7 10 air
camera third
give wooden_sword 1
wield wooden_sword
aim 0 0 1
wait 0.5
mark
hold use_primary 1.2
assert player.swings >= 3
assert player.action_dips == 0
wait 0.8
assert player.action_weight == 0
wield copper_pickaxe
aim 0.05 -1 0.05
mark
hold use_primary 1
assert player.swings >= 2
assert player.action_dips == 0
camera first
assert errors == 0

# --- P1-14 ---
# Ranged weapons in hand. First person: a bow shows the first arrows (ammo slots, then backpack) on the string, loosed
# at the release and laid back on by the re-draw end, and points at the crosshair; so does a gun, its recoil settled
# half a second after a shot. Third person: a drawn bow stands upright with its back on the aim.
killall
heal
fill -10 -3 -10 10 -1 10 stone
fill -10 0 -10 10 7 10 air
camera first
give wooden_bow 1
give wooden_arrow 20
wield wooden_bow
aim 0 0 1
wait 0.3
assert fp.arrow == 1
assert fp.aim_error_deg < 3
press use_primary
wait 0.08
assert fp.arrow == 0
release use_primary
wait 0.6
assert fp.arrow == 1
give flintlock_pistol 1
give musket_ball 20
wield flintlock_pistol
wait 0.3
assert fp.arrow == -1
assert fp.aim_error_deg < 3
use
wait 0.5
assert fp.aim_error_deg < 3
# P3-07: every shot kicks the first-person gun (settled again by now); each shot of a burst kicks on its own.
assert fp.kicks == 1
assert fp.recoil < 0.05
give clockwork_assault_rifle 1
wield clockwork_assault_rifle
wait 0.3
use
wait 0.5
assert fp.kicks == 3
assert fp.aim_error_deg < 3
# Food is raised to the mouth, kept clear of the near plane.
give cooked_fish 3
wield cooked_fish
wait 0.3
use
wait 0.15
assert fp.depth >= 0.24
assert fp.depth < 0.4
wait 0.5
camera third
wield wooden_bow
wait 0.5
press use_primary
wait 0.1
assert player.held_tilt_deg < 15
assert player.held_aim_deg < 15
# P3-06: the bow is gripped by its riser (its grip socket, off the model's origin) on the bow style's hand frame.
assert avatar.grip_error_cm >= 0
assert avatar.grip_error_cm < 1
release use_primary
camera first

# --- P4-18 ---
# A spike beside the player bites once they step onto it.
tp spawn
wait 1
fill -6 -3 -6 6 -1 6 stone
fill -6 0 -6 6 6 6 air
heal
place spike 1 0 0
wait 0.5
tp ~1 ~ ~
wait 0.3
assert player.life < 100
tp ~-3 ~ ~
heal
assert errors == 0

# --- P4-20 ---
# The Magic Missile casts one guided missile (it follows the crosshair while the wand is held).
wait_until projectiles.count == 0 5
give magic_missile 1
wield magic_missile
aim 0 0.3 1
use
assert projectiles.count >= 1
assert errors == 0

# --- P3-04 ---
# What is seen is what hits: a sword's overhead arc comes down in front, so a slime 1.5 m ahead at the feet is struck
# by the blade coming down in front (the swing curve's angle at the hit is within 15 degrees of the horizon, long past
# the wind-up's 165 degrees behind the head). A spear's
# thrust reaches a slime 2.3 m away that a shortsword's falls short of.
killall
heal
fill -10 -3 -10 10 -1 10 stone
fill -10 0 -10 10 7 10 air
camera first
give wooden_sword 1
wield wooden_sword
aim 0 0 1
spawn green_slime 1 1.5
ai off
wait 0.2
use
wait 0.8
assert npcs.alive_life < 14
assert melee.hit_deg < 15
assert melee.hit_deg > -15
assert melee.hit_dist < 2.2
killall
give copper_shortsword 1
wield copper_shortsword
spawn green_slime 1 2.3
wait 0.2
use
wait 0.6
assert npcs.alive_life == 14
give spear 1
wield spear
use
wait 0.8
assert npcs.alive_life < 14
assert melee.hit_deg == -999
assert melee.hit_dist > 2
# Status visuals (P3-47): a buff's emitter attaches while it lasts and is handed back when it ends or its carrier dies.
killall
buff on_fire
wait 0.2
assert buff.on_fire == 1
assert fx.status_emitters >= 1
buff clear
wait 0.2
assert fx.status_emitters == 0
spawn green_slime 2 4
wait 0.2
buff poisoned 10 npcs
buff frostburn 10 npcs
wait 0.2
assert fx.status_emitters >= 4
killall
wait 0.3
assert fx.status_emitters == 0
# Swings and shots smash pots and cut grass (P3-23); a chair stands.
killall
fill -3 0 1 3 3 8 air
place pot 0 0 2
place wooden_chair 2 0 2
smashed reset
give copper_broadsword 1
wield copper_broadsword
aim 0 -0.3 1
use
wait 0.6
assert objects.smashed == 1
place grass_tuft 0 0 6
give wooden_bow 1
give wooden_arrow 20
wield wooden_bow
aim 0 -0.42 1
use
wait 1
assert objects.smashed == 2
# Yoyos (P3-12): held out on a string while the button is down, striking the zombie again and again; home when let go.
killall
give wood_yoyo 1
wield wood_yoyo
spawn zombie 1 3
aim 0 0 1
press use_primary on
wait 0.6
assert projectiles.count == 1
assert projectiles.strings == 1
# The yoyo is on its string, not in the fist too: the held model hides while it is out, and is back once it is home.
assert avatar.held_hidden == 1
wait 1.5
press use_primary off
wait 2
assert projectiles.count == 0
assert npcs.zombie == 0
assert avatar.held_hidden == 0
# Whip lashes are drawn and crack (P3-15).
give leather_whip 1
wield leather_whip
use
wait 0.2
assert whips.drawn == 1
assert avatar.held_hidden == 1
wait 0.6
assert whips.cracks >= 1
# Flails (P3-13): whirled on the chain while held, flung when let go, reeled back in.
give ball_o_hurt 1
wield ball_o_hurt
press use_primary on
wait 0.5
assert projectiles.count == 1
assert projectiles.strings == 1
assert avatar.held_hidden == 1
# ...and in first person too, back in hand once the flail is reeled in.
camera first
wait 0.1
assert view.held_hidden == 1
press use_primary off
wait 3
assert projectiles.count == 0
assert avatar.held_hidden == 0
assert view.held_hidden == 0
camera third
# Projectile views are pooled (P1b-15): forty sparks in volleys reuse the views of the ones that burned out, and the
# glowing ones near the camera share the preset's few lights. Shots leave the held wand's tip (P3-10).
give wand_of_sparking 1
wield wand_of_sparking
aim 0 0.1 1
probe projectiles.nodes_created
repeat 10 use
heal
wait 2
repeat 10 use
heal
wait 2
repeat 10 use
heal
wait 2
repeat 10 use
wait 0.1
assert projectiles.nodes_created <= 34
probe projectiles.lights
assert projectiles.from_muzzle >= 1
assert fx.muzzle_flashes >= 1
assert projectiles.pooled >= 1
ai on
killall
assert errors == 0
# --- P3-27 ---
# Sound voices: the Crystal Storm fires every 7 ticks and each shot's zap rings for 0.6 s, so a held burst would play
# more of one sound than an id may hold (3): the oldest is stolen, and no pool ever sounds more voices than it has.
clear
heal
give crystal_storm 1
wield crystal_storm
aim 0 0 1
wait 1
audio reset
assert sfx.stolen == 0
hold use_primary 0.6
probe sfx.peak
probe sfx.stolen
assert sfx.stolen >= 1
assert sfx.peak <= sfx.cap
assert sfx.voices <= 48
assert errors == 0
# --- P3-29 ---
# Hearts: a slime slain while hurt drops a Heart that flies in, heals 20 and takes no slot.
clear
heal
pickups always
hurt 50
assert player.life <= 50
spawn green_slime 1 2
ai off
slay green_slime
assert drops.heart == 1
probe drops.heart
wait_until drops.heart == 0 3
assert player.life >= 70
assert inv.heart == 0
# A full backpack: the Heart is still taken, but the slime's gel is not pulled and stays on the ground.
wait 1
assert drops.gel == 0
clear
give stone 99999
give stone 99999
give stone 99999
give stone 99999
give stone 99999
give stone 99999
hurt 30
spawn green_slime 1 2
slay green_slime
assert drops.heart == 1
wait_until drops.heart == 0 3
wait 1
assert drops.gel >= 1
assert inv.gel == 0
pickups default
clear
ai on
killall
assert errors == 0
