# Rescues (P5-06): a bound Goblin Tinkerer is freed, then moves into a player-built home.
wait_until player.frozen == 0 180
spawning off
time noon
town arrivals off
fill -16 -3 -16 16 -1 16 stone
fill -16 0 -16 16 10 16 air
wait 0.5
flag defeated_goblin_army
town bind goblin_tinkerer 4 0 0
assert town.goblin_tinkerer.bound == 1
assert town.goblin_tinkerer.posture == 3
town rescue goblin_tinkerer
assert flag.rescued_goblin_tinkerer == 1
assert town.goblin_tinkerer.bound == 0
assert town.goblin_tinkerer.posture == 0
# P5-08: the debug pose command sets a resting posture for tours.
town pose goblin_tinkerer sit
assert town.goblin_tinkerer.posture == 1
town pose goblin_tinkerer stand

# A home east of the player (as in town.cmds); the guide is dismissed so the goblin gets it.
fill 3 0 -5 13 6 5 gray_brick
fill 4 0 -4 12 5 4 air
fill 8 0 -5 9 3 -5 air
place wooden_door 8 0 -5
place torch 4 0 4
place wooden_table 9 0 1
place wooden_chair 5 0 1
town dismiss guide
town check force
assert town.goblin_tinkerer.homed == 1
assert errors == 0
