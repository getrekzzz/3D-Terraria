# World events: start, spawn modifiers, sky tint, end at phase change, kill goals.
wait_until player.frozen == 0 180
spawning off
time 22
event blood_moon
assert event.blood_moon == 1
event list
spawning now
wait 1
time dawn
wait 0.3
assert event.blood_moon == 0
event slime_rain
assert event.slime_rain == 1
event stop slime_rain
assert event.slime_rain == 0
assert errors == 0

# --- X-06 ---
# Seasons: the console forces Halloween and Christmas (residents put on hats); a goodie bag opens; back to the date.
season halloween
assert season.id == 1
wait 0.2
give goodie_bag
wield goodie_bag
use
assert inv.goodie_bag == 0
season christmas
assert season.id == 2
wait 0.2
season off
assert season.id == 0
season auto
assert errors == 0
