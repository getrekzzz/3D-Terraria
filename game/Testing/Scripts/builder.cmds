# Builder's gear: climbing rope, riding a minecart along its track, wiring a lever to a door and a pressure plate to a dart trap,
# and a chest whose lid swings open while it is shown.
# Runs with: godot --headless --path . -- --world=smoke-builder --size=tiny --new --player=smoke --fresh-player --view=2 --smoke=res://game/Testing/Scripts/builder.cmds

wait_until player.frozen == 0 180
wait 1
spawning off
killall
time noon
fill -14 -3 -14 14 -1 14 stone
fill -14 0 -14 14 30 14 air
wait 1.0
assert player.on_floor == 1

# A rope hangs through the player's column: holding jump climbs it, letting go hangs on, crouch slides back down.
fill 0 0 0 0 14 0 rope
mark
hold jump 1.2
assert player.from_mark > 3
wait 0.8
assert player.from_mark > 3
hold crouch 2.5
wait 0.5
assert player.on_floor == 1
fill 0 0 0 0 14 0 air

# Minecart: a straight run of track north, boarded with the Minecart and driven forward.
place minecart_track 0 0 -1
place minecart_track 0 0 -2
place minecart_track 0 0 -3
place minecart_track 0 0 -4
place minecart_track 0 0 -5
place minecart_track 0 0 -6
place minecart_track 0 0 -7
place minecart_track 0 0 -8
place minecart_track 0 0 -9
place minecart_track 0 0 -10
clear
give minecart 1
select 1
aim 0 -2 -1
use
assert player.minecart == 1
mark
hold move_forward 2.5
assert player.from_mark > 3
hold jump 0.05
wait 1
assert player.minecart == 0
assert errors == 0

# Wiring: a lever beside a door, wired through the floor and up into the door; flipping the lever opens it.
tp spawn
wait 1
fill -14 -3 -14 14 -1 14 stone
fill -14 0 -14 14 30 14 air
wait 0.5
place wooden_door 4 0 2
place lever 1 0 2
wire 1 -1 2 4 -1 2
wire 4 0 2 4 0 2
assert wires.count >= 5
interact 1 0 2
place dart_trap 5 0 0 3
wire 0 -1 0 5 -1 0
wire 5 0 0 5 0 0
assert projectiles.count == 0
place pressure_plate 0 0 0
wait 0.02
assert projectiles.count >= 1
wait 0.5
assert player.life < 100
assert errors == 0

# Chest lid: opening the chest swings its lid up (drawn as its own MultiMesh), putting the chest away shuts it again.
place wooden_chest -4 0 -3
wait 0.5
assert objects.open_lids == 0
interact -4 0 -3
wait 0.4
assert objects.open_lids == 1
ui close
wait 0.4
assert objects.open_lids == 0
assert errors == 0

# --- X-15 ---
# Wire colours, actuators, a timer and teleporters. A lever on yellow wire switches an actuated wall off and on; a running
# 1 second timer on green wire swaps whoever stands on one teleporter pad to the other.
tp spawn
wait 1
fill -14 -3 -14 14 -1 14 stone
fill -14 0 -14 14 30 14 air
wait 0.5
heal
fill 3 0 -3 3 2 -3 stone
wire 3 0 -3 3 2 -3 actuator
assert wires.actuators == 3
place lever 0 0 -3
wire 0 -1 -3 3 -1 -3 yellow
wire 3 0 -3 3 2 -3 yellow
interact 0 0 -3
assert wires.inactive == 3
interact 0 0 -3
assert wires.inactive == 0
place teleporter -6 0 4
place teleporter 4 0 4
place timer_1_second 0 0 2
wire -5 0 5 5 0 5 green
wire 0 0 2 0 0 4 green
assert wires.green >= 13
interact 0 0 2
tp ~-5 ~1 ~5
wait 0.2
mark
wait_until wires.teleports >= 1 3
assert player.from_mark > 4
assert errors == 0

# --- P4-17 ---
# A Blue Dungeon Chandelier placed by hand hangs from a stone ceiling.
tp spawn
wait 1
fill -14 -3 -14 14 -1 14 stone
fill -14 0 -14 14 30 14 air
fill -6 6 -8 6 6 -1 stone
wait 0.5
clear
give blue_dungeon_chandelier 1
wield blue_dungeon_chandelier
aim 0 1 -1
use
wait 0.1
assert inv.blue_dungeon_chandelier == 0
assert errors == 0

# --- X-03 banners ---
# A Zombie Banner hung on a wall empowers the player against zombies (the Monster Banner buff shows).
tp spawn
wait 1
fill -14 -3 -14 14 -1 14 stone
fill -14 0 -14 14 30 14 air
fill -3 0 -5 3 6 -5 stone
wait 0.5
give zombie_banner 1
place zombie_banner 0 2 -4
wait 1
assert banners.near >= 1
assert buff.monster_banner == 1
assert errors == 0

# --- X-03 signs ---
# A sign keeps what it says (object meta): write two lines, read them back.
give sign 1
place sign 2 0 2
sign Welcome|to Strata
assert signs.text == 17
sign clear
assert signs.text == 0
assert errors == 0
