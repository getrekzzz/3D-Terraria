# Movement gear: grappling hook, rocket boots and wings, extra jumps and dashing.
# Runs with: godot --headless --path . -- --world=smoke-move --size=tiny --new --player=smoke --fresh-player --view=2 --smoke=res://game/Testing/Scripts/movement.cmds

wait_until player.frozen == 0 180
wait 1.5
assert player.alive == 1
spawning off
killall

# A walled arena with a stone ceiling slab 8 m overhead.
fill -14 -3 -14 14 -1 14 stone
fill -14 0 -14 14 40 14 air
fill -4 16 -4 4 17 4 stone
wait 1.0
assert player.on_floor == 1

# The hook flies up, latches onto the ceiling (its claw on the slab's face) and reels the player in; jumping lets go.
# It is worn in the hook slot (no longer counted as carried) and the grapple key throws the worn one.
equip grappling_hook
assert inv.grappling_hook == 0
mark
aim 0 1 0
hold grapple 0.05
wait 0.2
assert player.hook >= 1
wait 1.5
assert player.hook == 2
assert player.from_mark > 4
assert player.hook_snap >= 0
assert player.hook_snap < 0.05
hold jump 0.05
wait 2.5
assert player.on_floor == 1
assert player.hook == 0

# Clicking with a hook held throws it too, and jumping lets go of that one as well.
give grappling_hook 1
wield grappling_hook
mark
aim 0 1 0
hold use_primary 0.05
wait 0.2
assert player.hook >= 1
wait 1.5
assert player.hook == 2
assert player.from_mark > 4
hold jump 0.05
wait 2.5
assert player.on_floor == 1
assert player.hook == 0

# Natural terrain: a stepped ceiling filled unflagged meshes smooth like generated rock, so its rendered surface sits off
# the cell grid. The hook thrown at its slope latches (its claw moved onto that surface) and stays latched while it
# reels the player in.
fill -6 16 -6 6 17 6 air
fill -5 14 -5 5 15 5 stone natural
fill -3 13 -3 3 13 3 stone natural
fill -1 12 -1 1 12 1 stone natural
wait 1.0
mark
aim 0.35 1 0.2
hold grapple 0.05
wait 1.8
assert player.hook == 2
wait 1.0
assert player.hook == 2
assert player.from_mark > 3
assert player.hook_snap >= 0

# Breaking the anchor lets go (offsets follow the reeled-in body: the box covers the ceiling, not the floor).
fill -10 -4 -10 10 12 10 air
wait 0.3
assert player.hook != 2
wait 2.5
assert player.on_floor == 1
assert player.hook == 0

# Platforms hold a hook too; jumping lets go and the player drops back to the floor.
setblock 0 12 0 wood platform
setblock 1 12 0 wood platform
setblock 0 12 1 wood platform
wait 0.5
aim 0 1 0
hold grapple 0.05
wait 1.5
assert player.hook == 2
assert player.hook_snap >= 0
hold jump 0.05
wait 2.5
assert player.on_floor == 1
assert player.hook == 0
fill -4 8 -4 4 16 4 air

# Rocket boots burn while jump is held in the air, and refill on landing.
equip rocket_boots
wait 0.5
assert player.flight_left > 1.5
hold jump 1.2
assert player.flight_left < 1.2
wait 4
assert player.on_floor == 1
assert player.flight_left > 1.5

# Double-tapping a direction dashes with the Shield of Cthulhu.
equip shield_of_cthulhu
aim 1 0 0
mark
hold move_right 0.05
hold move_right 0.05
wait 0.3
assert player.from_mark > 2
assert player.alive == 1
assert errors == 0
