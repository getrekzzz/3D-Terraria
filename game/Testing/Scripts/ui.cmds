# Phase 2 UI smoke test: the global theme, font and UI scale; every later Phase 2 work package appends its block.
# Runs with: godot --headless --path . -- --world=smoke-ui --size=tiny --new --player=smoke --fresh-player --view=2 --smoke=res://game/Testing/Scripts/ui.cmds

wait_until player.frozen == 0 180
wait 0.5
assert errors == 0

# --- P2-01 ---
# The shipped bold font is the global fallback, an unthemed panel is Terraria blue, and the exported theme file
# (project.godot [gui] theme/custom) matches the code-built theme.
assert ui.font == 1
assert ui.theme == 1
assert ui.theme_synced == 1
probe ui.warmup_ms
# Raising the UI scale is clamped so the logical viewport never drops below 1024x600.
uiscale 1.5
assert ui.scale <= 1.5
assert ui.scale >= 0.5
uiscale 3
probe ui.scale
uiscale 1
assert ui.scale == 1
# Screens open and close with the theme applied.
ui inventory
wait 0.2
ui map
wait 0.2
ui close
wait 0.2
assert errors == 0

# --- P2-02 ---
# The HUD preloaded every generated UI sprite (tools/textures/build_ui.py) and none fell back to "missing".
assert ui.sprites_missing == 0
assert ui.sprites >= 35

# --- P2-03 ---
# Every buff and invasion icon loaded from assets/icons; a potion's buff is listed with its generated icon.
assert ui.status_icons_missing == 0
give regeneration_potion 1
wield regeneration_potion
use
wait_until buff.regeneration == 1 5
wait 0.2
assert hud.buff_icons >= 1
assert errors == 0

# --- P2-20 ---
# A hurt enemy shows a mini health bar (no 'life/max' text); it goes when the enemy does.
god on
spawning off
killall
fill -10 -3 -10 10 -1 10 stone
fill -10 0 -10 10 7 10 air
wait 1.0
wield copper_shortsword
aim 0 -0.2 1
spawn green_slime 1 1.5
wait 0.5
ai off
use
wait 0.3
assert npcs.alive_life < 14
assert fx.health_bars >= 1
killall
wait 0.2
assert fx.health_bars == 0
ai on
god off
assert errors == 0
