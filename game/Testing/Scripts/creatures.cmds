# Biome creatures: every new kind spawns, moves and renders; ranged attackers shoot; swimmers live in water.
wait_until player.frozen == 0 180
spawning off
town arrivals off
time noon
fill -14 -3 -14 14 -1 14 stone
fill -14 0 -14 14 10 14 air
# A pond for the swimmers.
fill 4 -3 4 9 -1 9 air
liquid water 4 -3 4 9 -1 9
wait 0.5
spawn blue_jellyfish 1
spawn shark 2
spawn vulture 1
spawn sand_slime 1
spawn ice_slime 1
spawn frozen_zombie 1
spawn jungle_slime 1
spawn man_eater 1
spawn crab 1
spawn skeleton 1
spawn hornet 1
spawn fire_imp 1
spawn lava_slime 1
spawn hellbat 1
assert npcs.count >= 15
heal
wait 3
assert npcs.hornet == 1
assert errors == 0
# Clearing up.
killall
assert npcs.count == 0
assert errors == 0

# --- P3-43/P3-44/P3-45/P3-50 ---
# Creatures with their own bodies now (canines, spiders, mimic, shark, flinx, tortoise, lizard, winged serpent, bone
# serpent, eater of souls, crimera, elementals, antlion), the reworked common enemies and the themed humanoids load
# and animate without problems.
god on
spawn wolf 1
spawn black_recluse 1
spawn mimic 1
spawn snow_flinx 1
spawn giant_tortoise 1
spawn salamander 1
spawn flying_snake 1
spawn bone_serpent 1
spawn eater_of_souls 1
spawn crimera 1
spawn granite_elemental 1
spawn antlion 1
spawn green_slime 1
spawn demon_eye 1
spawn cave_bat 1
spawn cursed_skull 1
spawn wyvern 1
spawn goblin_warrior 1
spawn pirate_captain 1
wait 1
assert props.problems == 0
assert errors == 0
killall
assert errors == 0
