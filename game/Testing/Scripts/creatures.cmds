# Biome creatures: every new kind spawns, moves and renders; ranged attackers shoot; swimmers live in water.
wait_until player.frozen == 0 180
spawning off
town arrivals off
time noon
fill -14 -3 -14 14 -1 14 stone
fill -14 0 -14 14 10 14 air
# A pond for the swimmers.
fill 4 -3 4 9 -1 9 air
liquid water 4 -3 4 9 -1 9
wait 0.5
spawn blue_jellyfish 1
spawn shark 2
spawn vulture 1
spawn sand_slime 1
spawn ice_slime 1
spawn frozen_zombie 1
spawn jungle_slime 1
spawn man_eater 1
spawn crab 1
spawn skeleton 1
spawn hornet 1
spawn fire_imp 1
spawn lava_slime 1
spawn hellbat 1
assert npcs.count >= 15
heal
wait 3
assert npcs.hornet == 1
assert errors == 0
# A disguised Mimic sits as a chest (harmless, still) until the player opens it, then wakes and hops after them.
killall
spawn mimic 1 3.5
wait 1
assert boss.mimic.disguised == 1
open_disguised
assert boss.mimic.disguised == 0
wait 1
assert npcs.mimic == 1
assert errors == 0
# Clearing up.
killall
assert npcs.count == 0
assert errors == 0
