# Screenshot tour: surface biomes, caves at three depths, the underworld, a town, night, the crypt and its halls, the Mawwall
# and the hardmode world.
# Rendering required for images (headless runs only exercise the route):
#   godot --path . --rendering-driver vulkan -- --world=tour --size=small --new --player=tour --fresh-player \
#         --view=4 --shots=/tmp/shots --smoke=res://game/Testing/Tours/tour.cmds
wait_until player.frozen == 0 300
spawning off
town arrivals off
camera third
time 10
aim 0 -0.12 1

wait_until stream.idle == 1 900
screenshot 01_spawn_forest
wait_until screenshot.pending == 0 900

biome desert
wait_until player.frozen == 0 300
wait_until stream.idle == 1 900
screenshot 02_desert
wait_until screenshot.pending == 0 900

biome tundra
wait_until player.frozen == 0 300
wait_until stream.idle == 1 900
screenshot 03_tundra
wait_until screenshot.pending == 0 900

biome jungle
wait_until player.frozen == 0 300
wait_until stream.idle == 1 900
screenshot 04_jungle
wait_until screenshot.pending == 0 900

biome ocean
wait_until player.frozen == 0 300
wait_until stream.idle == 1 900
screenshot 05_ocean
wait_until screenshot.pending == 0 900

# Underground: a held torch lights the way.
tp spawn
wait_until player.frozen == 0 300
select 4
tp cave underground
wait_until player.frozen == 0 300
aim 0 -0.05 1
wait_until stream.idle == 1 900
screenshot 06_cave
wait_until screenshot.pending == 0 900

tp cave cavern
wait_until player.frozen == 0 300
wait_until stream.idle == 1 900
screenshot 07_cavern
wait_until screenshot.pending == 0 900

tp cave underworld
wait_until player.frozen == 0 300
wait_until stream.idle == 1 900
screenshot 08_underworld
wait_until screenshot.pending == 0 900

# A small town at spawn with its residents gathered round.
tp spawn
wait_until player.frozen == 0 300
select 1
fill -8 -1 -2 8 -1 22 stone
fill -8 0 -2 8 9 22 air
fill -4 0 12 6 6 22 gray_brick
fill -3 0 13 5 5 21 air
fill 0 0 12 1 3 12 air
place wooden_door 0 0 12
place torch -3 0 21
place wooden_table 1 0 18
place wooden_chair -2 0 18
town dismiss guide
wait_until stream.idle == 1 900
town summon guide -3 0 6
town summon merchant 1 0 5
town summon nurse 4 0 7
town summon dryad -6 0 8
town talk guide
town talk merchant
town talk nurse
town talk dryad
aim 0 -0.2 1
wait 1
screenshot 09_town
wait_until screenshot.pending == 0 900

time 23
wait 1
screenshot 10_night
wait_until screenshot.pending == 0 900

# The crypt gate at dusk, its keeper waiting outside, then the Crypt Warden he keeps.
time 18
tp landmark dungeon_gate
wait_until player.frozen == 0 300
wait_until town.old_man == 1 60
aim 0.6 0.1 -1
wait_until stream.idle == 1 900
screenshot 11_crypt_gate
wait_until screenshot.pending == 0 900
time 21
aim 0 0.3 -1
boss skeletron 16
wait 1.2
heal
screenshot 12_crypt_warden
wait_until screenshot.pending == 0 900
killall

# Inside the Dungeon (spawning is off, so the guardian stays away): the keep's facade at noon, the pillared foyer over the
# entrance shaft, a winding hall hung with banners, a library and a treasure room.
time 12
tp landmark dungeon_gate
wait_until player.frozen == 0 300
aim landmark dungeon_shaft 0.35
wait_until stream.idle == 1 900
screenshot 12a_keep_facade
wait_until screenshot.pending == 0 900
tp landmark dungeon_foyer
wait_until player.frozen == 0 300
aim landmark dungeon_shaft -0.3
wait_until stream.idle == 1 900
screenshot 12b_keep_foyer
wait_until screenshot.pending == 0 900
tp landmark dungeon_hall
wait_until player.frozen == 0 300
aim landmark dungeon_banner 0.1
wait_until stream.idle == 1 900
screenshot 12c_banner_hall
wait_until screenshot.pending == 0 900
tp landmark dungeon_library
wait_until player.frozen == 0 300
aim 1 0.1 0.3
wait_until stream.idle == 1 900
screenshot 12d_library
wait_until screenshot.pending == 0 900
tp landmark dungeon_treasure
wait_until player.frozen == 0 300
aim 0.3 0 1
wait_until stream.idle == 1 900
screenshot 12e_treasure_room
wait_until screenshot.pending == 0 900

# The Mawwall rising over an obsidian ledge in the underworld (god mode keeps the camera alive).
god on
tp cave underworld
wait_until player.frozen == 0 300
liquids off
fill -10 -2 -10 10 -1 10 obsidian
fill -10 0 -10 10 8 10 air
liquid none -10 0 -10 10 8 10
wait_until stream.idle == 1 1200
wait 1
boss wall_of_flesh 5
aim -1 0.2 0
wait 16
heal
screenshot 13_mawwall
wait_until screenshot.pending == 0 900
killall
liquids on
god off

# Hardmode: the world changes. Spread is paused so the converted land stops remeshing for the camera.
mutations spread off
flag defeated_wall_of_flesh
wait_until mutation.behind == 0 120
tp zone hallow
wait_until player.frozen == 0 300
time 10
aim 0.3 -0.15 1
wait_until stream.idle == 1 900
wait 1
screenshot 14_radiant_wedge
wait_until screenshot.pending == 0 900
mutations spread on
assert errors == 0
