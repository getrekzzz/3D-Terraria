# Feel tour (rendered): a felled tree toppling away from the player, then a first-person hurt flash. Time runs slow
# around the captures so the software renderer catches the moment.
wait_until player.frozen == 0 300
spawning off
town arrivals off
time 12
killall
fill -10 -1 -10 10 -1 14 stone
fill -10 0 -10 10 14 14 air
camera third
wait_until stream.idle == 1 900
place oak_tree 3 0 0
wield copper_axe
aim 0.9 0.15 0.35
timescale 0.25
hold use_primary 4
wait_until effects.tree_falls > 0 20
wait 0.1
timescale 0.02
screenshot a_tree_fall 0
wait_until screenshot.pending == 0 900
timescale 1
wait 2
camera first
heal
spawn zombie 0 1.2
aim 0 0 1
wait_until hud.hurt_flashes > 0 10
timescale 0.02
screenshot b_hurt 0
wait_until screenshot.pending == 0 900
timescale 1
