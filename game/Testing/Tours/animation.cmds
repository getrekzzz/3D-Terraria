# Animation tour (timescale slows animation, not the simulation: waits after "use" are animation time): the player's body from the side while idling, running, swinging, mining, lunging with a spear,
# shooting, drawing a bow, casting, drinking, then every other use style's clip (a rapier jab, a throw, eating, holding
# up a crate, a staff, a tome, a whip crack, a yoyo and a flail on the right arm) and holding a torch; first-person bow,
# gun and pickaxe; zombies shambling and dying; bosses turning to look.
#   godot --path . --rendering-driver vulkan -- --world=anim --size=tiny --new --player=anim --fresh-player \
#         --view=2 --shots=/tmp/shots --smoke=res://game/Testing/Tours/animation.cmds
wait_until player.frozen == 0 300
spawning off
liquids off
town arrivals off
town dismiss guide
god on
time 12
camera third
fill -40 -1 -30 40 -1 60 stone
fill -40 0 -30 40 16 60 air
aim 0 -0.05 1
camera orbit 95
wait_until stream.idle == 1 900
wait 2
screenshot a_idle
wait_until screenshot.pending == 0 900

give copper_broadsword
wield copper_broadsword
wait 0.5
timescale 0.01
use
wait 0.12
screenshot b_swing 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give copper_pickaxe
wield copper_pickaxe
wait 0.3
timescale 0.01
use
wait 0.14
screenshot c_mine 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give spear
wield spear
wait 0.3
timescale 0.01
use
wait 0.16
screenshot d_spear 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give flintlock_pistol
give musket_ball 50
wield flintlock_pistol
aim 0 0.35 1
wait 0.3
timescale 0.01
use
wait 0.1
screenshot e_shoot_up 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give wooden_bow
give wooden_arrow 50
wield wooden_bow
aim 0 0 1
wait 0.3
timescale 0.01
use
wait 0.2
screenshot f_bow 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give wand_of_sparking
wield wand_of_sparking
wait 0.3
timescale 0.01
use
wait 0.14
screenshot g_cast 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give lesser_healing_potion 3
wield lesser_healing_potion
wait 0.3
timescale 0.01
use
wait 0.12
screenshot h_drink 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1

# The other use styles at mid-clip: the rapier's jab held out, the throw just let go, the second bite, the crate held
# high, the staff lifting, the tome pushed out, the whip at its crack.
give copper_shortsword
wield copper_shortsword
wait 0.3
timescale 0.01
use
wait 0.06
screenshot h1_rapier 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give shuriken 20
wield shuriken
wait 0.3
timescale 0.01
use
wait 0.05
screenshot h2_throw 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
