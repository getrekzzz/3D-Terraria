wield wooden_crate
wait 0.3
timescale 0.01
use
wait 0.2
screenshot h4_hold_up 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give amethyst_staff
wield amethyst_staff
wait 0.3
timescale 0.01
use
wait 0.05
screenshot h5_staff 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give water_bolt
wield water_bolt
