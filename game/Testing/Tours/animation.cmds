wait_until screenshot.pending == 0 900
timescale 1
wait 1
# Looping right-arm clips while the button is held: a yoyo worked by the wrist, a flail spun over the head.
give wood_yoyo
wield wood_yoyo
press use_primary
wait 0.3
screenshot h8_yoyo 0
wait_until screenshot.pending == 0 900
release use_primary
wait 1
give sunfury
wield sunfury
press use_primary
wait 0.4
screenshot h9_flail 0
wait_until screenshot.pending == 0 900
release use_primary
wait 1
assert anim.missing_clips == 0
give torch 10
wield torch
time 21
wait 1
screenshot i_torch_hold
wait_until screenshot.pending == 0 900
time 12

# Running (legs along the run, torso to the aim) and running while swinging.
wield copper_broadsword
press move_forward
wait 0.6
screenshot j_run
wait_until screenshot.pending == 0 900
timescale 0.01
use
wait 0.12
screenshot k_run_swing 0
wait_until screenshot.pending == 0 900
timescale 1
press move_forward off
press move_right
wait 0.6
screenshot l_strafe
wait_until screenshot.pending == 0 900
press move_right off
press jump
wait 0.25
screenshot m_jump 0
wait_until screenshot.pending == 0 900
press jump off
wait 1.5

# First person: a bow held upright with an arrow on the string, the arrow gone just after the release, and a pistol
# pointing along the view at the crosshair.
camera first
wield wooden_bow
give wooden_arrow 20
wait 0.5
screenshot q_fp_bow_rest
wait_until screenshot.pending == 0 900
press use_primary
wait 0.05
screenshot q_fp_bow_release 0
wait_until screenshot.pending == 0 900
release use_primary
wait 0.6
wield flintlock_pistol
wait 0.5
screenshot r_fp_gun
wait_until screenshot.pending == 0 900
camera third
wait 0.5

# First person: a held pickaxe mid-chop (the view model eases up, strikes and settles on the use's timing).
camera first
wield copper_pickaxe
press use_primary
wait 0.2
screenshot s_fp_mine 0
wait_until screenshot.pending == 0 900
release use_primary
camera third
wait 0.5

camera orbit 0
spawn zombie 3 6
wait 1.5
screenshot n_zombies
wait_until screenshot.pending == 0 900
slay zombie
wait 0.9
screenshot o_zombie_death 0
wait_until screenshot.pending == 0 900
wait 2
time 21
spawn demon_eye 1 5
wait 1.5
screenshot p_demon_eye_look
wait_until screenshot.pending == 0 900
