# Boss gallery: with creatures frozen (ai off, so none flee by day or charge), every boss is summoned in front of the
# player in daylight and photographed;
# the Wall of Flesh last, in the underworld where it stays.
#   godot --path . --rendering-driver vulkan -- --world=gallery --size=small --new --player=gallery --fresh-player \
#         --view=3 --shots=/tmp/shots --smoke=res://game/Testing/Tours/bosses.cmds
wait_until player.frozen == 0 300
spawning off
liquids off
town arrivals off
town dismiss guide
god on
camera third
time 12
fill -60 -1 -20 60 -1 90 stone
fill -60 0 -20 60 12 90 air
fill -60 13 -20 60 25 90 air
fill -60 26 -20 60 38 90 air
wait_until stream.idle == 1 900
ai off

time 12
aim 0 0.1 1
boss king_slime 14
wait 0.5
screenshot 01_king_slime 0.5
wait_until screenshot.pending == 0 900
killall
wait 0.5

time 12
aim 0 0.15 1
boss eye_of_cthulhu 14
wait 0.5
