# Furniture families and mounts (rendered): a marble, an ebonwood and a mushroom set laid out on a stone floor, then the
# player riding the Slimy Saddle and the Cosmic Car Key's UFO.
#   godot --path . --rendering-driver vulkan -- --world=families --size=tiny --new --player=tour --fresh-player \
#         --view=3 --shots=/tmp/shots --smoke=res://game/Testing/Tours/families.cmds
wait_until player.frozen == 0 300
spawning off
town arrivals off
god on
time 11
tp spawn
wait_until player.frozen == 0 300
fill -12 -1 -2 12 -1 20 stone
fill -12 0 -2 12 12 20 air
wait_until stream.idle == 1 900
place marble_table -8 0 8
place marble_chair -11 0 8
place marble_bookcase -10 0 12
place marble_clock -6 0 12
place marble_candelabra -8 2 8
place ebonwood_bed -2 0 10
place ebonwood_piano 1 0 13
place ebonwood_lamp -3 0 13
place ebonwood_chest 0 0 8
place mushroom_sofa 5 0 12
place mushroom_table 6 0 8
place mushroom_chair 10 0 8
place mushroom_lamp 10 0 12
place glass_bathtub 4 0 4
camera third
aim 0 -0.25 1
wait 2
screenshot a_families
wait_until screenshot.pending == 0 900
give slimy_saddle
wield slimy_saddle
use
aim 0.8 -0.1 0.6
wait 1
screenshot b_slime_mount
wait_until screenshot.pending == 0 900
use
give cosmic_car_key
wield cosmic_car_key
use
hold jump 0.6
wait 1
screenshot c_ufo
wait_until screenshot.pending == 0 900
