# Game-feel tour (rendered): creatures of different materials burst into dust and gore; mining throws lit chips.
wait_until player.frozen == 0 300
spawning off
town arrivals off
god on
time 12
fill -10 -1 -10 10 -1 14 stone
fill -10 0 -10 10 8 14 air
camera third
aim 0 -0.2 1
wait_until stream.idle == 1 900
spawn zombie 0 6
spawn green_slime 2 5
spawn skeleton -2 5
wait 1.5
slay
wait 0.12
screenshot a_gore
wait_until screenshot.pending == 0 900
wield copper_pickaxe
aim 0.05 -1 0.3
hold use_primary 0.6
wait 0.3
screenshot b_chips
wait_until screenshot.pending == 0 900
