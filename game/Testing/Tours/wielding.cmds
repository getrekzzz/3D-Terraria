# Wielding tour: close shots of the player's held items (in the fist) through each use action, from the side, then
# the player's face. timescale slows animation, not the simulation: waits after "use" are animation time.
#   godot --path . --rendering-driver vulkan -- --world=wield --size=tiny --new --player=wield --fresh-player \
#         --view=2 --shots=/tmp/shots --smoke=res://game/Testing/Tours/wielding.cmds
wait_until player.frozen == 0 300
spawning off
liquids off
town arrivals off
town dismiss guide
god on
time 12
camera third
fill -40 -1 -30 40 -1 60 stone
fill -40 0 -30 40 16 60 air
aim 0 -0.05 1
camera orbit 100
camera distance 2.2
wait_until stream.idle == 1 900
wait 2

give copper_broadsword
wield copper_broadsword
wait 1
screenshot w01_carry
wait_until screenshot.pending == 0 900
camera orbit 160
camera distance 1.6
wait 1
screenshot w10_player_face
wait_until screenshot.pending == 0 900
camera orbit 100
camera distance 2.2
wait 1
timescale 0.01
use
wait 0.04
screenshot w02_swing_a 0
wait_until screenshot.pending == 0 900
wait 0.04
screenshot w02_swing_b 0
wait_until screenshot.pending == 0 900
wait 0.04
screenshot w02_swing_c 0
wait_until screenshot.pending == 0 900
wait 0.04
screenshot w02_swing_d 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give copper_pickaxe
wield copper_pickaxe
wait 0.3
timescale 0.01
use
wait 0.18
screenshot w04_mine 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give spear
wield spear
wait 0.3
timescale 0.01
use
wait 0.26
screenshot w05_thrust 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give flintlock_pistol
give musket_ball 50
wield flintlock_pistol
wait 0.3
timescale 0.01
use
wait 0.05
screenshot w06_shoot 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give wooden_bow
give wooden_arrow 50
wield wooden_bow
wait 0.3
timescale 0.01
use
wait 0.2
screenshot w07_bow 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give wand_of_sparking
wield wand_of_sparking
wait 0.3
timescale 0.01
use
wait 0.14
screenshot w08_cast 0
wait_until screenshot.pending == 0 900
timescale 1
wait 1
give torch 10
wield torch
wait 1
screenshot w09_torch
wait_until screenshot.pending == 0 900
