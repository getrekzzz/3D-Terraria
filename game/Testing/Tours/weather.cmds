# Weather tour (rendered): a thunderstorm over the spawn, then a blizzard and a sandstorm look (forced on any biome).
#   godot --path . --rendering-driver vulkan -- --world=weather --size=tiny --new --player=tour --fresh-player \
#         --view=3 --shots=/tmp/shots --smoke=res://game/Testing/Tours/weather.cmds
wait_until player.frozen == 0 300
spawning off
town arrivals off
god on
time 15
camera third
aim 0.6 -0.12 1
wait_until stream.idle == 1 900
weather storm
wait 25
screenshot a_storm
wait_until screenshot.pending == 0 900
weather blizzard
wait 6
screenshot b_blizzard
wait_until screenshot.pending == 0 900
weather sandstorm
wait 6
screenshot c_sandstorm
wait_until screenshot.pending == 0 900
