<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer CLI: content validation, coverage report, manifest generation, worldgen reports. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Strata.Tools</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Strata.Core/Strata.Core.csproj" />
  </ItemGroup>
</Project>
